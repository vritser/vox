        (vox-log--entries nil))
    (vox-test-audio
      (funcall on-bytes (unibyte-string 1))
      (vox-core-stop)
      (funcall on-ended)
      (should (eq (vox-session-state session) 'error))
      (let ((log (mapconcat #'identity
