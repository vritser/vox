;;; vox-test-sessions.el --- Successive session isolation regressions -*- lexical-binding: t; no-byte-compile: t; -*-

;; SPDX-License-Identifier: GPL-3.0-or-later
;;; Commentary:
;; Synthetic PCM and transcripts; no microphone, credential, or provider access.
;;; Code:
(require 'vox-test-support)

(ert-deftest vox-sessions-late-duration-timer-preserves-stop-reason ()
  :tags '(vox-unit)
  (let ((vox--generation 0) (vox-event-log-enabled nil))
    (dolist (phase '(draining finalizing))
      (vox-test-session
        (setf (vox-session-methods session)
              (plist-put (vox-session-methods session) :needs-external-audio t))
        (cl-letf (((symbol-function 'vox-audio-start) (lambda (&rest _) nil))
                  ((symbol-function 'vox-audio-stop) #'ignore)
                  ((symbol-function 'vox-audio-cancel) #'ignore))
          (funcall ready)
          (let ((timer (vox-session-duration-timer session)))
            (should (timerp timer))
            (setf (vox-session-statistics session)
                  (plist-put (vox-session-statistics session) :stop-reason 'silence))
            (vox-core-stop session)
            (when (eq phase 'finalizing) (vox-core-audio-ended session))
            (should (eq (vox-session-state session) phase))
            (apply (timer--function timer) (timer--args timer))
            (should (eq (plist-get (vox-session-statistics session) :stop-reason)
                        'silence))
            (should (eq (vox-session-state session) phase))
            (should (= finishes (if (eq phase 'finalizing) 1 0)))))))))

(ert-deftest vox-sessions-complete-cancel-error-keep-audio-and-text-isolated ()
  :tags '(vox-unit)
  (let ((vox--active-session nil) (vox--last-session nil) (vox--generation 0)
        (vox--backends (copy-hash-table vox--backends))
        (vox-event-log-enabled nil)
        (vox-stop-mode 'silence) (vox-silence-threshold 0.01)
        (vox-silence-seconds 1.2) (vox-audio-backlog-seconds 2)
        (callbacks (make-hash-table :test #'eq))
        (sent (make-hash-table :test #'eql))
        retained old-activities expected-sent commits expected-commits finishes expected-finishes
        stopped closed)
    (vox-register-backend
     'synthetic-rounds
     (list :needs-external-audio t :chunk-ms 100
           :connect
           (lambda (session ready emit fail)
             (setf (vox-session-backend-state session)
                   (list :synthetic-round (vox-session-generation session)))
             (puthash session (list :ready ready :emit emit :fail fail) callbacks))
           :send-pcm
           (lambda (session bytes)
             (let ((round (vox-session-generation session)))
               (puthash round (append (gethash round sent) (list bytes)) sent)))
           :finish (lambda (session) (push (vox-session-generation session) finishes))
           :cancel #'ignore
           :close (lambda (session) (push (vox-session-generation session) closed))))
    (cl-letf (((symbol-function 'vox-audio-start)
               (lambda (session bytes ended error)
                 (puthash session
                          (append (gethash session callbacks)
                                  (list :bytes bytes :ended ended :error error))
                          callbacks)
                 (list :synthetic-recorder (vox-session-generation session))))
              ((symbol-function 'vox-audio-stop)
               (lambda (session) (push (vox-session-generation session) stopped)))
              ((symbol-function 'vox-audio-cancel)
               (lambda (session) (setf (vox-session-recorder session) nil))))
      (with-temp-buffer
        (unwind-protect
            (cl-loop
             for outcome in '(completed cancelled error completed)
             for round from 1
             do
             (let* ((session
                     (vox-core-start
                      'synthetic-rounds
                      (list :on-finish
                            (lambda (owner text)
                              (push (cons (vox-session-generation owner) text) commits)))))
                    (connection (gethash session callbacks))
                    (connect-timer (vox-session-connect-timer session))
                    (activity (vox-session-activity session))
                    (full-frame (make-string 3200 (+ 16 round)))
                    (tail (unibyte-string round (+ 64 round)))
                    (pcm (concat (apply #'concat (make-list 9 full-frame)) tail))
                    (expected-packets (if (eq outcome 'completed)
                                          (append (make-list 9 full-frame) (list tail))
                                        (make-list 8 full-frame)))
                    (transcript (format "SYNTHETIC ROUND %d" round))
                    timers)
               (should (timerp connect-timer))
               (funcall (plist-get connection :ready))
               (should-not (memq activity old-activities))
               (push activity old-activities)
               (should (eq (vox-session-state session) 'recording))
               (should (equal (vox-session-audio-pending session) (unibyte-string)))
               (should (equal (vox-session-text session) ""))
               (should-not (vox-activity--armed activity))
               (should-not (vox-session-finish-sent session))
               (should-not (vox-session-committed session))
               ;; Replay every predecessor's callbacks and all five core timers.
               (dolist (old retained)
                 (let ((events (car old)))
                   (funcall (plist-get events :ready))
                   (funcall (plist-get events :bytes) (make-string 3200 127))
                   (funcall (plist-get events :ended))
                   (funcall (plist-get events :error) "Synthetic stale capture error")
                   (funcall (plist-get events :emit)
                            '(:type :snapshot :text "SYNTHETIC OBSOLETE" :revision 999))
                   (funcall (plist-get events :emit) '(:type :completed))
                   (funcall (plist-get events :fail) "Synthetic stale provider error"))
                 (dolist (timer (cdr old))
                   (apply (timer--function timer) (timer--args timer))))
               (should (eq (vox-current-session) session))
               (should (eq (vox-session-state session) 'recording))
               (should (equal (vox-session-recorder session)
                              (list :synthetic-recorder round)))
               (should-not (gethash round sent))
               (should (= (hash-table-count sent) (length expected-sent)))
               (dolist (expected expected-sent)
                 (should (equal (gethash (car expected) sent) (cdr expected))))
               (should (equal (vox-session-audio-pending session) (unibyte-string)))
               (should (equal (vox-session-text session) ""))
               (should-not (vox-activity--armed activity))
               (should (equal commits expected-commits))
               (should (equal finishes expected-finishes))
               (let ((events (gethash session callbacks)))
                 (funcall (plist-get events :bytes) pcm)
                 (funcall (plist-get events :emit)
                          (list :type :snapshot :text transcript :revision 1 :final-p t))
                 (should (vox-activity--armed activity))
                 (should (equal (gethash round sent) (make-list 8 full-frame)))
                 (should (equal (vox-session-audio-pending session)
                                (concat full-frame tail)))
                 (vox-core-stop session)
                 (setq timers
                       (list connect-timer (vox-session-audio-timer session)
                             (vox-session-duration-timer session)
                             (vox-session-preview-timer session)
                             (vox-session-stop-timer session)))
                 (should (cl-every #'timerp timers))
                 (when (eq outcome 'completed)
                   (funcall (plist-get events :ended)))
                 (should (eq (vox-session-state session)
                             (if (eq outcome 'completed) 'finalizing 'draining)))
                 (should (equal (gethash round sent) expected-packets))
                 (should (equal (apply #'concat (gethash round sent))
                                (if (eq outcome 'completed)
                                    pcm
                                  (substring pcm 0 (* 8 3200)))))
                 (should (equal finishes
                                (if (eq outcome 'completed)
                                    (cons round expected-finishes)
                                  expected-finishes)))
                 (should (equal commits expected-commits))
                 (pcase outcome
                   ('completed
                    (funcall (plist-get events :emit) '(:type :completed))
                    (push round expected-finishes)
                    (push (cons round transcript) expected-commits))
                   ('cancelled (vox-core-cancel session))
                   ('error (funcall (plist-get events :fail) "Synthetic active failure")))
                 (push (cons events timers) retained))
               (should (eq (vox-session-state session) outcome))
               (should (vox-session-cleaned session))
               (should-not (vox-current-session))
               (should (eq vox--last-session session))
               (should (equal (vox-session-audio-pending session) (unibyte-string)))
               (should-not (vox-session-activity session))
               (should-not (vox-session-recorder session))
               (should-not (vox-session-backend-state session))
               (should-not (marker-buffer (vox-session-target-marker session)))
               (should-not (cl-some
                            #'identity
                            (list (vox-session-audio-timer session)
                                  (vox-session-connect-timer session)
                                  (vox-session-duration-timer session)
                                  (vox-session-preview-timer session)
                                  (vox-session-stop-timer session))))
               (should (= (plist-get (vox-session-statistics session) :sent-bytes)
                          (if (eq outcome 'completed) (length pcm) (* 8 3200))))
               (should (equal (gethash round sent) expected-packets))
               (push (cons round expected-packets) expected-sent)
               (should (equal commits expected-commits))
               (should (equal finishes expected-finishes))
               (should (equal stopped (reverse (number-sequence 1 round))))
               (should (equal closed (reverse (number-sequence 1 round))))))
          (vox-core-cancel))))
    (should (equal commits '((4 . "SYNTHETIC ROUND 4") (1 . "SYNTHETIC ROUND 1"))))
    (should (equal finishes '(4 1)))
    (should (= (hash-table-count sent) 4))))

(provide 'vox-test-sessions)
;;; vox-test-sessions.el ends here
