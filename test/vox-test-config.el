;;; Commentary:
;; Offline synthetic data only: no credentials, files, microphone, or network.
;;; Code:
(require 'vox-test-support)
(require 'vox-backend)
(require 'vox-backend-qwen)
(require 'vox-backend-doubao)

(ert-deftest vox-config-factory-defaults ()
  :tags '(vox-unit)
  (let ((qwen (vox-make-qwen "Qwen")) (doubao (vox-make-doubao "Doubao")))
    (should (vox-backend-p qwen))
    (should (eq (vox-backend-type qwen) 'qwen))
    (should (equal (vox-backend-name qwen) "Qwen"))
    (should (equal (vox-backend-host qwen) "dashscope.aliyuncs.com"))
    (should (equal (vox-backend-endpoint qwen) "/api-ws/v1/realtime"))
    (should (equal (vox-backend-models qwen) '("qwen3-asr-flash-realtime")))
    (should-not (vox-backend-key qwen))
    (should (eq (vox-backend-type doubao) 'doubao))
    (should (equal (vox-backend-host doubao) "openspeech.bytedance.com"))
    (should (equal (vox-backend-endpoint doubao) "/api/v3/sauc/bigmodel_async"))
    (should (equal (vox-backend-models doubao) '("bigmodel")))
    (should (equal (vox-backend-resource-id doubao) "volc.seedasr.sauc.duration"))))

(ert-deftest vox-config-pure-factories-and-metadata ()
  :tags '(vox-unit)
  (let ((before (hash-table-count vox--backends)) (calls 0))
    (cl-letf (((symbol-function 'vox-api-key-from-auth-source)
               (lambda (&rest _) (ert-fail "Secret I/O")))
              ((symbol-function 'auth-source-search) (lambda (&rest _) (ert-fail "Auth I/O")))
              ((symbol-function 'getenv) (lambda (&rest _) (ert-fail "Environment I/O")))
              ((symbol-function 'make-process) (lambda (&rest _) (ert-fail "Process I/O")))
              ((symbol-function 'make-network-process) (lambda (&rest _) (ert-fail "Network I/O"))))
      (let* ((key (lambda () (cl-incf calls) "synthetic"))
             (configuration (vox-make-qwen "Pure" :key key))
             (methods (vox-backend-methods configuration nil)))
        (vox-backend-snapshot configuration)
        (vox-backend-url configuration nil)
        (should (eq (vox-backend-key (plist-get methods :configuration)) key))
        (should (zerop calls))
        (should (= before (hash-table-count vox--backends)))))))

(ert-deftest vox-config-normalizes-and-copies-models ()
  :tags '(vox-unit)
  (let* ((text (copy-sequence "second"))
         (models (list 'first text))
         (configuration (vox-make-qwen "Models" :models models)))
    (should (equal (vox-backend-models configuration) '("first" "second")))
    (aset text 0 ?X)
    (setcar models 'changed)
    (should (equal (vox-backend-models configuration) '("first" "second")))))

(ert-deftest vox-config-rejects-invalid-identifiers ()
  :tags '(vox-unit)
  (dolist (name '(nil bad 7 "" " " "bad\nname" "bad\177name"))
    (should-error (vox-make-qwen name) :type 'user-error))
  (dolist (models '(nil [] first (first . second) (nil) (7) ("") (" ")
                       ("bad\rmodel") ("bad\000model") (first "first")))
    (should-error (vox-make-qwen "Models" :models models) :type 'user-error))
  (let ((cycle (list 'first)))
    (setcdr cycle cycle)
    (should-error (vox-make-qwen "Models" :models cycle) :type 'user-error)))

(ert-deftest vox-config-rejects-key-and-resource-fields ()
  :tags '(vox-unit)
  (dolist (key (list 7 'not-a-function '(not-a-function) "" "bad\nkey"
                     "bad\000key"))
    (should-error (vox-make-qwen "Key" :key key) :type 'user-error))
  (dolist (resource '(nil 7 resource "" " " "bad\nresource" "bad\tresource"
                      "wrong:resource" "bad resource" "bad/resource"))
    (should-error (vox-make-doubao "Resource" :resource-id resource) :type 'user-error)))

(ert-deftest vox-config-literal-key-is-accepted-and-copied ()
  :tags '(vox-unit)
  (let* ((literal (copy-sequence "synthetic-literal"))
         (configuration (vox-make-qwen "Key" :key literal)))
    (should (equal (vox-backend-key configuration) "synthetic-literal"))
    (should-not (eq (vox-backend-key configuration) literal))
    (aset literal 0 ?X)
    (should (equal (vox-backend-key configuration) "synthetic-literal"))
    (cl-letf (((symbol-function 'auth-source-search)
               (lambda (&rest _) (ert-fail "Literal key consulted auth-source"))))
      (should (equal (vox-backend-secret configuration "example.test")
                     "synthetic-literal")))))

(ert-deftest vox-config-errors-name-the-invalid-field ()
  :tags '(vox-unit)
  (dolist (case (list (cons (lambda () (vox-make-qwen nil)) "backend name")
                      (cons (lambda () (vox-make-qwen "Name" :host "bad host"))
                            "backend host")
                      (cons (lambda () (vox-make-qwen "Name" :endpoint "relative"))
                            "backend endpoint")
                      (cons (lambda () (vox-make-qwen "Name" :models '(7)))
                            "model identifier")
                      (cons (lambda () (vox-make-qwen "Name" :key 7))
                            "backend key")
                      (cons (lambda () (vox-make-doubao "Name" :resource-id "a:b"))
                            "resource identifier")))
    (let ((err (should-error (funcall (car case)) :type 'user-error)))
      (should (string-match-p (cdr case) (error-message-string err))))))

(ert-deftest vox-config-rejects-malformed-hosts-and-endpoints ()
  :tags '(vox-unit)
  (dolist (host '(nil "" "wss://example.com" "http://example.com" "user@example.com"
                     "example.com/path" "example.com?x" "example.com#x" "bad\nhost"
                     "bad host" "-bad.test" "bad-.test" "bad..test" ".bad.test"
                     "example.com:" "example.com:abc" "example.com:0"
                     "example.com:65536" "example.com\\other"))
    (should-error (vox-make-qwen "Host" :host host) :type 'user-error))
  (dolist (endpoint '(nil "" "relative" "//other.test/path" "wss://other.test"
                         "/path#fragment" "/path\nheader" "/path with spaces"
                         "/{model}" "/path\\other" "/path%" "/path%a" "/path%xy"))
    (should-error (vox-make-qwen "Endpoint" :endpoint endpoint) :type 'user-error))
  (should (equal (vox-backend-url
                  (vox-make-doubao "Custom" :host "localhost:8443" :endpoint "/path?a=%20") nil)
                 "wss://localhost:8443/path?a=%20")))

(ert-deftest vox-config-snapshot-detaches-every-mutable-field ()
  :tags '(vox-unit)
  (let* ((key (lambda () "synthetic"))
         (original (vox-make-doubao "Name" :key key))
         (snapshot (vox-backend-snapshot original)))
    (should-not (eq original snapshot))
    (should (eq (vox-backend-key original) (vox-backend-key snapshot)))
    (dolist (accessor '(vox-backend-name vox-backend-host vox-backend-endpoint
                       vox-backend-resource-id))
      (let ((expected (copy-sequence (funcall accessor snapshot))))
        (aset (funcall accessor original) 0 ?X)
        (should (equal (funcall accessor snapshot) expected))))
    (aset (car (vox-backend-models original)) 0 ?X)
    (setcdr (vox-backend-models original) '("another"))
    (should (equal (vox-backend-models snapshot) '("bigmodel")))
    (should (eq (vox-backend-snapshot 'fake) 'fake))))

(ert-deftest vox-config-methods-capture-explicit-and-default-model ()
  :tags '(vox-unit)
  (let* ((configuration (vox-make-qwen "Models" :models '(first second)))
         (model (copy-sequence "second"))
         (methods (vox-backend-methods configuration model)))
    (should (equal (plist-get methods :model) "second"))
    (should-not (eq model (plist-get methods :model)))
    (aset model 0 ?X)
    (aset (cadr (vox-backend-models configuration)) 0 ?X)
    (should (equal (plist-get methods :model) "second"))
    (should (equal (vox-backend-models (plist-get methods :configuration))
                   '("first" "second")))
    (should (equal (plist-get (vox-backend-methods configuration) :model) "first"))
    (should (equal (plist-get (vox-backend-methods configuration nil) :model) "first"))
    (should (equal (plist-get (vox-backend-methods configuration 'first) :model) "first"))
    (should-error (vox-backend-methods configuration 'missing) :type 'user-error)
    (should-error (vox-backend-methods configuration "bad\nmodel") :type 'user-error)
    (should-error (vox-backend-methods configuration 3) :type 'user-error)))

(ert-deftest vox-config-methods-preserve-registry-functions-and-copy-data ()
  :tags '(vox-unit)
  (let* ((vox--backends (copy-hash-table vox--backends))
         (metadata (list "label"))
         (methods (list :connect #'ignore :finish #'ignore :cancel #'ignore
                        :close #'ignore :metadata metadata)))
    (vox-register-backend 'fake methods)
    (let ((copy (vox-backend-methods 'fake '(invalid-model))))
      (should-not (eq copy methods))
      (should (eq (plist-get copy :connect) #'ignore))
      (should-not (plist-member copy :configuration))
      (should-not (plist-member copy :model))
      (aset (car (plist-get copy :metadata)) 0 ?X)
      (setf (plist-get copy :connect) #'identity)
      (should (equal metadata '("label")))
      (should (eq (plist-get methods :connect) #'ignore)))))

(ert-deftest vox-config-builtin-symbol-shortcuts-and-safe-unknown-errors ()
  :tags '(vox-unit)
  (let ((vox-selection '("Missing" invalid)))
    (dolist (backend '(qwen doubao))
      (let ((methods (vox-backend-methods backend)))
        (should (vox-backend-p (plist-get methods :configuration)))
        (should (eq (vox-backend-type (plist-get methods :configuration)) backend))
        (should (stringp (plist-get methods :model))))))
  (let ((err (should-error (vox-backend-methods '(synthetic-secret)) :type 'user-error)))
    (should (equal (error-message-string err) "Unknown Vox backend"))))

(ert-deftest vox-config-mutable-records-are-revalidated ()
  :tags '(vox-unit)
  (dolist (mutate (list (lambda (c) (setf (vox-backend-host c) "bad@host"))
                       (lambda (c) (setf (vox-backend-endpoint c) "//evil.test"))
                       (lambda (c) (setf (vox-backend-models c) nil))
                       (lambda (c) (setf (vox-backend-key c) 7))
                       (lambda (c) (setf (vox-backend-key c) ""))))
    (let ((configuration (vox-make-qwen "Mutable")))
      (funcall mutate configuration)
      (should-error (vox-backend-snapshot configuration) :type 'user-error)
      (should-error (vox-backend-methods configuration nil) :type 'user-error)
      (should-error (vox-backend-url configuration nil) :type 'user-error))))

(ert-deftest vox-config-qwen-query-model-replacement-and-escaping ()
  :tags '(vox-unit)
  (let ((configuration
         (vox-make-qwen "Query" :models '("chosen &/=?+#")
                        :endpoint "/path?model=old&x=a%26b&%6dodel=again&model&y=two")))
    (should (equal (vox-backend-url configuration "chosen &/=?+#")
                   "wss://dashscope.aliyuncs.com/path?x=a%26b&y=two&model=chosen%20%26%2F%3D%3F%2B%23")))
  (should (equal (vox-backend-url (vox-make-qwen "Query" :models '(m)
                                                               :endpoint "/path?") nil)
                 "wss://dashscope.aliyuncs.com/path?model=m")))

(ert-deftest vox-config-doubao-url-does-not-change-query ()
  :tags '(vox-unit)
  (let ((configuration (vox-make-doubao "Query" :models '(first second)
                                      :endpoint "/path?model=server&x=1")))
    (should (equal (vox-backend-url configuration 'second)
                   "wss://openspeech.bytedance.com/path?model=server&x=1"))
    (should-error (vox-backend-url configuration 'missing) :type 'user-error)))

(ert-deftest vox-config-secret-callable-is-lazy-and-not-cached ()
  :tags '(vox-unit)
  (let* ((calls 0)
         (key (lambda () (format "synthetic-%d" (cl-incf calls))))
         (configuration (vox-make-qwen "Key" :key key))
         (methods (vox-backend-methods configuration nil)))
    (should (zerop calls))
    (cl-letf (((symbol-function 'vox-api-key-from-auth-source)
               (lambda (&rest _) (ert-fail "Default lookup used"))))
      (should (equal (vox-backend-secret configuration "example.test") "synthetic-1"))
      (should (equal (vox-backend-secret configuration "example.test") "synthetic-2")))
    (should (eq (vox-backend-key configuration) key))
    (should (eq (vox-backend-key (plist-get methods :configuration)) key))
    (should-not (plist-member methods :key))))

(ert-deftest vox-config-secret-default-uses-auth-source-only ()
  :tags '(vox-unit)
  (let (observed-host)
    (cl-letf (((symbol-function 'auth-source-search)
               (lambda (&rest args)
                 (setq observed-host (plist-get args :host))
                 (should (equal (plist-get args :user) "apikey"))
                 (list (list :secret (lambda () "synthetic-auth")))))
              ((symbol-function 'getenv)
               (lambda (&rest _) (ert-fail "Environment lookup used"))))
      (should (equal (vox-backend-secret (vox-make-qwen "Key") "custom.test")
                     "synthetic-auth"))
      (should (equal observed-host "custom.test")))))

(ert-deftest vox-config-secret-default-errors-name-the-host ()
  :tags '(vox-unit)
  (cl-letf (((symbol-function 'auth-source-search) (lambda (&rest _) nil))
            ((symbol-function 'getenv)
             (lambda (&rest _) (ert-fail "Environment lookup used"))))
    (let ((err (should-error (vox-backend-secret (vox-make-qwen "Key")
                                                 "example.test")
                             :type 'user-error)))
      (should (string-match-p "example.test" (error-message-string err)))
      (should (string-match-p ":key" (error-message-string err))))))

(ert-deftest vox-config-secret-key-function-needs-no-default-lookup ()
  :tags '(vox-unit)
  (let ((configuration (vox--make-backend
                        :name "custom" :type 'custom :host "example.test"
                        :endpoint "/path" :models '("model")
                        :key (lambda () "synthetic-key"))))
    (cl-letf (((symbol-function 'vox-api-key-from-auth-source)
               (lambda (&rest _) (ert-fail "Default lookup used"))))
      (should (equal (vox-backend-secret configuration "example.test")
                     "synthetic-key")))))

(ert-deftest vox-config-secret-errors-and-invalid-values-are-redacted ()
  :tags '(vox-unit)
  (dolist (key (list (lambda () (error "synthetic-secret"))
                    (lambda () nil) (lambda () 7) (lambda () "")
                    (lambda () "synthetic-secret\r\ninjected")
                    (lambda () "synthetic-secret\000injected")
                    (lambda () "synthetic-secret\tbad")))
    (let ((err (should-error
                (vox-backend-secret (vox-make-qwen "Key" :key key) "example.test")
                :type 'user-error)))
      (should-not (string-match-p "synthetic-secret" (error-message-string err)))))
  (cl-letf (((symbol-function 'auth-source-search)
             (lambda (&rest _) (error "synthetic-secret"))))
    (let ((err (should-error (vox-backend-secret (vox-make-qwen "Key") "example.test"))))
      (should-not (string-match-p "synthetic-secret" (error-message-string err))))))

(ert-deftest vox-config-secret-quit-propagates ()
  :tags '(vox-unit)
  (should (eq (condition-case nil
                  (vox-backend-secret
                   (vox-make-qwen "Quit" :key (lambda () (signal 'quit nil)))
                   "example.test")
                (quit 'cancelled))
              'cancelled)))

(ert-deftest vox-config-auth-source-key-uses-the-connecting-host ()
  :tags '(vox-unit)
  (let (queried)
    (cl-letf (((symbol-function 'auth-source-search)
               (lambda (&rest args)
                 (setq queried (list (plist-get args :host)
                                     (plist-get args :user)))
                 '((:secret "synthetic-auth"))))
              ((symbol-function 'getenv)
               (lambda (&rest _) (ert-fail "Auth-source key read the environment"))))
      (let ((configuration
             (vox-make-qwen "Key" :key #'vox-api-key-from-auth-source)))
        (should (equal (vox-backend-secret configuration "custom.test")
                       "synthetic-auth"))
        (should (equal queried '("custom.test" "apikey")))))))

(ert-deftest vox-config-auth-source-key-accepts-explicit-host-and-user ()
  :tags '(vox-unit)
  (let ((vox--auth-source-host "connecting.test") queried)
    (cl-letf (((symbol-function 'auth-source-search)
               (lambda (&rest args)
                 (setq queried (list (plist-get args :host)
                                     (plist-get args :user)))
                 '((:secret "synthetic")))))
      (should (equal (vox-api-key-from-auth-source) "synthetic"))
      (should (equal queried '("connecting.test" "apikey")))
      (should (equal (vox-api-key-from-auth-source "other.test" "me")
                     "synthetic"))
      (should (equal queried '("other.test" "me"))))))

(ert-deftest vox-config-auth-source-key-fails-closed ()
  :tags '(vox-unit)
  (cl-letf (((symbol-function 'auth-source-search) (lambda (&rest _) nil))
            ((symbol-function 'getenv)
             (lambda (&rest _) (ert-fail "Auth-source key read the environment"))))
    (let ((vox--auth-source-host "host.test"))
      (should-error (vox-api-key-from-auth-source) :type 'user-error))
    (let ((vox--auth-source-host nil))
      (should-error (vox-api-key-from-auth-source) :type 'user-error))))

(ert-deftest vox-config-auth-source-only-key-never-falls-back-to-environment ()
  :tags '(vox-unit)
  (cl-letf (((symbol-function 'auth-source-search) (lambda (&rest _) nil))
            ((symbol-function 'getenv)
             (lambda (&rest _) (ert-fail "Environment fallback used"))))
    (let ((configuration
           (vox-make-qwen "Key" :key #'vox-api-key-from-auth-source)))
      (let ((err (should-error (vox-backend-secret configuration "host.test")
                               :type 'user-error)))
        (should (string-match-p "credential unavailable"
                                (error-message-string err)))))))

(ert-deftest vox-config-has-no-legacy-variable-fallback ()
  :tags '(vox-unit)
  (cl-progv '(vox-qwen-model vox-qwen-endpoint vox-doubao-endpoint
              vox-doubao-resource-id vox-doubao-key-environment)
      '("legacy" "wss://legacy.test" "wss://legacy.test"
        "legacy-resource" "LEGACY_ASR_KEY")
    (should (equal (vox-backend-models (vox-make-qwen "New"))
                   '("qwen3-asr-flash-realtime")))
    (should (equal (vox-backend-models (vox-make-doubao "New")) '("bigmodel")))
    (should (equal (vox-backend-url (vox-make-qwen "New") nil)
                   "wss://dashscope.aliyuncs.com/api-ws/v1/realtime?model=qwen3-asr-flash-realtime"))
    (should (equal (vox-backend-url (vox-make-doubao "New") nil)
                   "wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async"))
    (should (equal (vox-backend-resource-id (vox-make-doubao "New"))
                   "volc.seedasr.sauc.duration"))))

(provide 'vox-test-config)
