(ert-deftest vox-ui-preview-never-edits-and-finish-undoes-once ()
  :tags '(vox-unit)
  (vox-test-session
    (buffer-enable-undo)
    (insert "typed")
    (set-marker (vox-session-target-marker session) (point))
    (let* ((sink (vox-make-buffer-sink))
           (preview (plist-get sink :on-preview))
           (before (buffer-string)) (before-undo buffer-undo-list)
           (before-point (point)) (before-mark (mark)))
      (setf (vox-session-sink session) sink)
      (dotimes (_ 1000) (funcall preview session "preview\nsecond line" 'recording))
      (should (equal before (buffer-string)))
      (should (equal before-undo buffer-undo-list))
      (should (= before-point (point))) (should (equal before-mark (mark)))
      (funcall ready)
      (insert " keyboard")
      (funcall emit '(:type :segment-final :id "a" :text " voice"))
      (vox-core-stop) (funcall emit '(:type :completed))
      (should (equal (buffer-string) "typed keyboard voice"))
      (should (= (point) (point-max)))
      (should-not (overlays-in (point-min) (point-max)))
      (let ((inhibit-message t)) (undo 1))
      (should (equal (buffer-string) "typed keyboard")))))

(ert-deftest vox-ui-preview-displays-text-without-decoration ()
  :tags '(vox-unit)
  (vox-test-session
    (let* ((vox-preview t)
           (sink (vox-make-buffer-sink)))
      (setf (vox-session-sink session) sink)
      (dolist (example '(("recognized words" . "recognized words")
                         ("literal [brackets]" . "literal [brackets]")
                         ("first\nsecond\tthird" . "first second third")))
        (funcall (plist-get sink :on-preview) session (car example) 'recording)
        (let* ((overlay (car (append (car (overlay-lists)) (cdr (overlay-lists)))))
               (display (overlay-get overlay 'after-string)))
          (should (equal (substring-no-properties display)
                         (cdr example)))
          (should (eq (get-text-property 0 'face display) 'shadow))))
      ;; Long hypotheses reach the overlay whole; wrapping belongs to display.
      (let* ((long (mapconcat (lambda (n) (format "word%d" n))
                              (number-sequence 1 60) " "))
             (expected (concat long " 尾")))
        (funcall (plist-get sink :on-preview) session (concat long "\n尾") 'recording)
        (let* ((overlay (car (append (car (overlay-lists)) (cdr (overlay-lists)))))
               (display (overlay-get overlay 'after-string)))
          (should (equal (substring-no-properties display) expected))
          (should-not (string-match-p "\n" display))
          (should-not (string-match-p "\\.\\.\\." display))))
      (should (equal (buffer-string) ""))
      (should (= (point) 1)))))

(ert-deftest vox-ui-finish-point-follows-insertion-only-at-target ()
  :tags '(vox-unit)
  ;; Synthetic completions at the beginning, middle, and end of a line.
  (dolist (positions '((1 1 6) (4 4 9) (7 7 12) (4 2 2) (4 6 11)))
    (vox-test-session
      (insert "abcdef")
      (let ((target (nth 0 positions)))
        (set-marker (vox-session-target-marker session) target)
        (goto-char (nth 1 positions))
        (set-mark 2)
        (setf (vox-session-sink session) (vox-make-buffer-sink))
        (funcall ready)
        (funcall emit '(:type :snapshot :text "VOICE"))
        (vox-core-stop)
        (funcall emit '(:type :completed))
        (should (eq (vox-session-state session) 'completed))
        (should (equal (buffer-string)
                       (concat (substring "abcdef" 0 (1- target)) "VOICE"
                               (substring "abcdef" (1- target)))))
        (should (= (point) (nth 2 positions)))
        (should (= (mark) (if (= target 1) 7 2)))))))

