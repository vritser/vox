(ert-deftest vox-ui-narrowed-target-keeps-marker-and-restriction ()
  :tags '(vox-unit)
  (dolist (bounds '((1 4) (10 14)))
    (vox-test-session
      (buffer-enable-undo)
      (insert "prefix|suffix")
      (set-marker (vox-session-target-marker session) 8)
      (setf (vox-session-sink session) (vox-make-buffer-sink))
      (funcall ready)
      (funcall emit '(:type :snapshot :text "VOICE"))
      (apply #'narrow-to-region bounds)
      (goto-char (1+ (point-min)))
      (set-mark (point-min))
      (let ((visible (buffer-string))
            (saved-point (point-marker))
            (saved-mark (copy-marker (mark)))
            (start (copy-marker (point-min)))
            (end (copy-marker (point-max))))
        (vox-core-stop)
        (funcall emit '(:type :completed))
        (should (eq (vox-session-state session) 'completed))
        (should (buffer-narrowed-p))
        (should (equal (buffer-string) visible))
        (should (= (point) saved-point))
        (should (= (mark) saved-mark))
        (should (= (point-min) start))
        (should (= (point-max) end))
        (save-restriction
          (widen)
          (should (equal (buffer-string) "prefix|VOICEsuffix"))
          (let ((inhibit-message t)) (undo 1))
          (should (equal (buffer-string) "prefix|suffix")))))))

(ert-deftest vox-ui-narrowed-preview-keeps-real-marker ()
  :tags '(vox-unit)
  ;; Narrowing must not relocate or clip the overlay: it still attaches at the
  ;; captured marker and carries the whole hypothesis.
  (dolist (bounds '((1 4) (10 14)))
    (vox-test-session
      (insert "prefix|suffix")
      (set-marker (vox-session-target-marker session) 8)
      (apply #'narrow-to-region bounds)
      (goto-char (point-min))
      (let* ((sink (vox-make-buffer-sink))
             (preview (plist-get sink :on-preview))
             (before-point (point))
             (before-undo buffer-undo-list))
        (setf (vox-session-sink session) sink)
        (funcall preview session "hypothesis" 'recording)
        (should (= (point) before-point))
        (should (equal buffer-undo-list before-undo))
        (should (equal (list (point-min) (point-max)) bounds))
        (let* ((overlay (car (append (car (overlay-lists)) (cdr (overlay-lists)))))
               (display (overlay-get overlay 'after-string)))
          (should overlay)
          (should (= (overlay-start overlay) 8))
          (should (= (overlay-end overlay) 8))
          (should (equal (substring-no-properties display) "hypothesis")))
        (save-restriction
          (widen)
          (should (equal (buffer-string) "prefix|suffix")))))))

(ert-deftest vox-ui-narrowed-read-only-target-preserves-final ()
  :tags '(vox-unit)
  (vox-test-session
    (insert "prefix|suffix")
    (set-marker (vox-session-target-marker session) 8)
    (put-text-property 7 9 'read-only t)
    (setf (vox-session-sink session) (vox-make-buffer-sink))
    (funcall ready)
    (funcall emit '(:type :snapshot :text "VOICE"))
    (narrow-to-region 1 4)
    (goto-char 2)
    (vox-core-stop)
    (funcall emit '(:type :completed))
    (should (eq (vox-session-state session) 'error))
    (should (equal (vox-session-final-text session) "VOICE"))
    (should (= (point) 2))
    (should (= (point-min) 1))
    (should (= (point-max) 4))
    (save-restriction
      (widen)
      (should (equal (buffer-string) "prefix|suffix")))))

(ert-deftest vox-security-endpoints-and-json ()
  :tags '(vox-unit)
