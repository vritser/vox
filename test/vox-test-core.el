    (should (string-match-p "opacity=\"1.0\"" (nth 0 frames)))
    (should-not (equal (nth 0 frames) (nth 1 frames)))))

(ert-deftest vox-ui-mode-line-idle-image-caches-by-color ()
  :tags '(vox-unit)
  ;; Synthetic image descriptors exercise the GUI path on headless Emacs.
  (let ((vox-ui--mode-line-idle-image nil)
        (vox-ui--mode-line-idle-color nil)
        (created 0))
    (cl-letf (((symbol-function 'display-graphic-p) (lambda (&optional _) t))
              ((symbol-function 'image-type-available-p)
               (lambda (type) (eq type 'svg)))
              ((symbol-function 'create-image)
               (lambda (data &rest _)
                 (cl-incf created)
                 (list 'image :type 'svg :data data))))
      (let ((image (vox-ui--mode-line-idle-image "#112233")))
        (should (eq (car-safe image) 'image))
        (should (string-match-p "#112233" (plist-get (cdr image) :data)))
        (should (eq image (vox-ui--mode-line-idle-image "#112233")))
        (should (= created 1))
        (let ((recolored (vox-ui--mode-line-idle-image "#445566")))
          (should-not (eq image recolored))
          (should (string-match-p "#445566"
                                  (plist-get (cdr recolored) :data)))
          (should (= created 2)))))))

