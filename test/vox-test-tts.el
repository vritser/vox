(ert-deftest vox-tts-cli-failure-empty-and-overflow-never-complete ()
  :tags '(vox-unit)
  (dolist (command '(("sh" "-c" "cat >/dev/null; printf partial; exit 7")
                     ("sh" "-c" "cat >/dev/null; exit 0")
                     ("sh" "-c" "cat >/dev/null; printf 123456")))
    (vox-tts-test--isolated
      (let ((vox-test-tts-cli-command command) (vox-tts-max-audio-bytes 5) played)
        ;; A late failure can follow partial playback, but never completes.
        (cl-letf (((symbol-function 'message) #'ignore))
          (let ((session (vox-speak "input" (vox-tts-test--cli))))
            (vox-tts-test--wait session)
            (setq played (eq (vox-tts--session-state session) 'completed))
            (should-not played)
            (should (eq (vox-tts--session-state session) 'error))))))))

