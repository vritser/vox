;;; vox-test-tts.el --- Speech output regressions -*- lexical-binding: t; no-byte-compile: t; -*-

;; SPDX-License-Identifier: GPL-3.0-or-later
;;; Commentary:
;; Synthetic protocol bytes and local subprocesses only.  Never play sound,
;; read real credentials, open a microphone, or contact a provider.
;;; Code:
(require 'vox-test-support)
(require 'vox)
(require 'vox-tts-qwen)

(defvar vox-test-tts-cli-command nil)

(defun vox-tts-test--cli ()
  "Return a named CLI with the current synthetic command."
  (vox-make-cli "CLI" :tts (list :command vox-test-tts-cli-command)))

(defmacro vox-tts-test--isolated (&rest body)
  "Run BODY with isolated speech state and a harmless player configuration."
  (declare (indent 0) (debug t))
  `(let ((vox-tts--active nil) (vox-tts--generation 0)
         (vox--active-session nil) (vox--starting nil) (vox--reloading nil)
         (vox-backends nil) (vox-tts-selection nil)
         (vox-tts--selection-revision 0)
         (vox-test-tts-cli-command '("sh" "-c" "cat"))
         (vox-tts-player-command '("sh" "-c" "cat >/dev/null"))
         (vox-tts-max-text-chars 4096) (vox-tts-max-audio-bytes 4096)
         (vox-tts-max-pending-bytes 4096)
         (vox-tts-max-response-bytes 8192) (vox-tts-timeout 5)
         (vox-tts-playback-timeout 5))
     (unwind-protect (progn ,@body) (vox-tts-stop))))

(defun vox-tts-test--wait (session)
  "Wait at most three seconds for synthetic SESSION to end."
  (let ((deadline (+ (float-time) 3)))
    (while (and (vox-tts--live-p session) (< (float-time) deadline))
      (accept-process-output nil 0.01)))
  (should-not (vox-tts--live-p session)))

(defmacro vox-tts-test--stream (backend &rest body)
  "Run BODY with BACKEND and synthetic source callbacks, without network I/O."
  (declare (indent 1) (debug t))
  `(vox-tts-test--isolated
     (let (data done request)
       (cl-letf (((symbol-function 'vox-tts-qwen-open)
                  (lambda (owner _backend _model)
                    (setf (vox-tts--session-source-close owner) (lambda () (setq request t))
                          (vox-tts--session-input-send owner) #'ignore
                          (vox-tts--session-input-finish owner) #'ignore)
                    (setq data (lambda (bytes)
                                 (condition-case nil (vox-tts--play owner bytes)
                                   (error (vox-tts--fail owner))))
                          done (lambda (success)
                                 (if success (vox-tts--source-finished owner)
                                   (vox-tts--fail owner))))))
                 ((symbol-function 'message) #'ignore))
         (let ((session (vox-speak "synthetic" ,backend)))
           ,@body)))))

(ert-deftest vox-tts-interactive-prompt-keeps-text-out-of-history ()
  :tags '(vox-unit)
  (let ((command-history '((forward-char 2)))
        (minibuffer-history '("previous"))
        (extended-command-history nil)
        spoken)
    (save-window-excursion
      (with-temp-buffer
        (switch-to-buffer (current-buffer))
        (cl-letf (((symbol-function 'vox-tts-start)
                   (lambda (text &rest _) (setq spoken text))))
          ;; Exercise the command loop: a stubbed `read-string' would miss
          ;; call-interactively's automatic command-history recording.
          (execute-kbd-macro (kbd "M-x vox-speak RET synthetic-private RET")))))
    (should (equal spoken "synthetic-private"))
    (should (equal minibuffer-history '("previous")))
    (should (member '(forward-char 2) command-history))
    (should-not (string-match-p "synthetic-private" (prin1-to-string command-history)))))

(ert-deftest vox-tts-interactive-region-keeps-text-out-of-command-history ()
  :tags '(vox-unit)
  (let ((command-history nil) (transient-mark-mode t) spoken)
    (with-temp-buffer
      (insert "synthetic-region")
      (set-mark (point-min))
      (setq mark-active t)
      (cl-letf (((symbol-function 'vox-tts-start)
                 (lambda (text &rest _) (setq spoken text)))
                ((symbol-function 'read-string)
                 (lambda (&rest _) (ert-fail "Active region should not prompt"))))
        (call-interactively #'vox-speak t)))
    (should (equal spoken "synthetic-region"))
    (should (equal command-history '((vox-speak nil))))))

(ert-deftest vox-tts-constructors-snapshot-and-lazy-keys ()
