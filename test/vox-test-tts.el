(ert-deftest vox-tts-cli-starts-player-before-synthesizer-exits ()
  :tags '(vox-unit)
  (vox-tts-test--isolated
    ;; exec keeps the waiting process owned, so cancellation leaves no child.
    (let* ((vox-test-tts-cli-command '("sh" "-c" "cat >/dev/null; printf first; exec sleep 5"))
           (session (vox-speak "text" (vox-tts-test--cli)))
           (source (car (vox-tts--session-processes session)))
           (deadline (+ (float-time) 2)))
      (while (and (not (vox-tts--session-player-process session)) (< (float-time) deadline))
        (accept-process-output nil 0.01))
      (should (eq (vox-tts--session-state session) 'playing))
      (should (process-live-p source))
      (should (= (vox-tts--session-audio-bytes session) 5))
      (should-not (vox-tts--session-source-done session))
      (vox-speak-stop)
      (should-not (process-live-p source)))))

(ert-deftest vox-tts-stream-replacement-and-recording-stop-a-running-player ()
  :tags '(vox-unit)
  (dolist (action '(replacement recording))
    (vox-tts-test--stream (vox-test-make-tts-qwen "O" :key "synthetic")
      (let ((old-data data) (old-done done))
        (funcall data "first")
        (vox-tts-test--pump-now session)
        (let ((player (vox-tts--session-player-process session)))
          (should (process-live-p player))
          (pcase action
            ('replacement
             (let ((successor (vox-speak "next" (vox-test-make-tts-qwen "O" :key "synthetic"))))
               (funcall old-data "stale")
               (funcall old-done t)
               (should (eq vox-tts--active successor))
               (should (= (vox-tts--session-audio-bytes successor) 0))))
            ('recording
             (vox-test-session
               (funcall old-data "stale")
               (funcall old-done t)
               (should-not vox-tts--active))))
          (should (eq (vox-tts--session-state session) 'cancelled))
          (should-not (process-live-p player))
          (should-not (vox-tts--session-chunks session)))))))

(ert-deftest vox-tts-stream-late-cli-nonzero-exit-stops-player ()
  :tags '(vox-unit)
  (vox-tts-test--isolated
    (let* ((vox-test-tts-cli-command '("sh" "-c" "cat >/dev/null; printf first; exec sleep 5"))
           (session (vox-speak "text" (vox-tts-test--cli)))
           (source (car (vox-tts--session-processes session)))
           (deadline (+ (float-time) 2)))
      (while (and (not (vox-tts--session-player-process session)) (< (float-time) deadline))
        (accept-process-output nil 0.01))
      (let ((player (vox-tts--session-player-process session))
            (sentinel (process-sentinel source))
            (status (symbol-function 'process-status))
            (exit-status (symbol-function 'process-exit-status)))
        (should (process-live-p player))
        (cl-letf (((symbol-function 'message) #'ignore)
                  ((symbol-function 'process-status)
                   (lambda (proc) (if (eq proc source) 'exit (funcall status proc))))
                  ((symbol-function 'process-exit-status)
                   (lambda (proc) (if (eq proc source) 7 (funcall exit-status proc)))))
          (funcall sentinel source "synthetic exit\n"))
        (should (eq (vox-tts--session-state session) 'error))
        (should-not (process-live-p player))))))

(ert-deftest vox-tts-qwen-wave-header-preserves-pcm-through-ffmpeg ()
  :tags '(vox-unit)
  (let ((pcm (unibyte-string 0 0 255 127 0 128 1 0 255 255)))
    (with-temp-buffer
      (set-buffer-multibyte nil)
      (insert vox-tts--pcm-wave-header pcm)
      (let ((coding-system-for-read 'binary) (coding-system-for-write 'binary))
        (should (= 0 (call-process-region (point-min) (point-max) "ffmpeg" t '(t nil) nil
                                          "-hide_banner" "-loglevel" "error" "-i" "pipe:0"
                                          "-f" "s16le" "-acodec" "pcm_s16le" "pipe:1"))))
      (should (equal (buffer-string) pcm)))))

(ert-deftest vox-tts-stream-splits-large-chunks-and-drains-before-eof ()
  :tags '(vox-unit)
  (vox-tts-test--stream (vox-test-make-tts-qwen "O" :key "synthetic")
    (setf (vox-tts--session-limit session) 10000
          (vox-tts--session-pending-limit session) 10000)
    (let ((audio (concat (make-string 4096 ?a) (make-string 4096 ?b) (make-string 808 ?c)))
          writes eof)
      (cl-letf (((symbol-function 'process-send-string)
                 (lambda (_process bytes) (push bytes writes)))
                ((symbol-function 'process-send-eof)
                 (lambda (_process) (setq eof t))))
        (funcall data audio)
        (funcall done t)
        (vox-tts-test--pump-now session)
        (should (equal (mapcar #'length writes) '(4096)))
        (should (= (vox-tts--session-pending-bytes session) 4904))
        (should-not eof)
        (vox-tts-test--pump-now session)
        (should (= (vox-tts--session-pending-bytes session) 808))
        (should-not eof)
        (vox-tts-test--pump-now session)
        (should (equal (mapcar #'length (reverse writes)) '(4096 4096 808)))
        (should (equal (apply #'concat (nreverse writes)) audio))
        (should eof)
        (should (= (vox-tts--session-pending-bytes session) 0))
        (should (= (vox-tts--session-chunk-count session) 0))
        (should-not (vox-tts--session-pump-timer session))))))

