(defun vox-tts-test--pump-now (session)
  "Run SESSION's scheduled pump deterministically."
  (when (timerp (vox-tts--session-pump-timer session))
    (cancel-timer (vox-tts--session-pump-timer session)))
  (vox-tts--pump session))

(ert-deftest vox-tts-stream-plays-before-source-completion-and-stops-all-resources ()
  :tags '(vox-unit)
  (vox-tts-test--stream (vox-test-make-tts-qwen "Q" :key "synthetic")
    (funcall data "abc")
    (vox-tts-test--pump-now session)
    (should (eq (vox-tts--session-state session) 'playing))
    (should (process-live-p (vox-tts--session-player-process session)))
    (should-not (vox-tts--session-source-done session))
    (should-not (vox-tts--session-eof session))
    (should (timerp (vox-tts--session-timer session)))
    (funcall data "de")
    (should (= (vox-tts--session-pending-bytes session) 2))
    (let ((processes (copy-sequence (vox-tts--session-processes session))))
      (vox-speak-stop)
      (should (cl-every (lambda (proc) (not (process-live-p proc))) processes)))
    (funcall data "de")
    (funcall done t)
    (vox-tts--pump session)
    (should (eq (vox-tts--session-state session) 'cancelled))
    (should request)
    (should (= (vox-tts--session-pending-bytes session) 0))
    (should-not (vox-tts--session-chunks session))
    (should-not (vox-tts--session-pump-timer session))
    (should-not (vox-tts--session-playback-timer session))
    (should-not (vox-tts--session-timer session))))

(ert-deftest vox-tts-stream-reentrant-write-preserves-order-and-defers-eof ()
  :tags '(vox-unit)
  (vox-tts-test--stream (vox-test-make-tts-qwen "O" :key "synthetic")
    (let (events (nested nil) (inside nil))
      (cl-letf (((symbol-function 'process-send-string)
                 (lambda (_process bytes)
                   (should-not inside)
                   (let ((inside t))
                     (push bytes events)
                     (unless nested
                       (setq nested t)
                       (funcall data "second")
                       (funcall done t)
                       (vox-tts--pump session)
                       (should-not (vox-tts--session-eof session))))))
                ((symbol-function 'process-send-eof)
                 (lambda (_process) (push 'eof events))))
        (funcall data "first")
        (vox-tts-test--pump-now session)
        (should (equal events '("first")))
        (should (= (vox-tts--session-pending-bytes session) 6))
        (vox-tts-test--pump-now session)
        (should (equal (nreverse events) '("first" "second" eof)))
        (should (= (vox-tts--session-pending-bytes session) 0))
        (should (= (vox-tts--session-chunk-count session) 0))))))

