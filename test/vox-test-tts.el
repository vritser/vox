         (backend (vox-test-make-tts-qwen "Q" :voice voice :key (lambda () (cl-incf calls))))
         (copy (vox-tts--snapshot backend)))
    (aset voice 0 ?X)
    (aset (vox-backend-voice backend) 1 ?X)
    (should (equal (vox-backend-voice copy) "Cherry"))
