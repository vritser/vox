;;; vox-test-autostop.el --- Short-phrase lifecycle tests -*- lexical-binding: t; no-byte-compile: t; -*-

;; SPDX-License-Identifier: GPL-3.0-or-later
;;; Commentary:
;; Synthetic PCM and a fake recorder/provider; no microphone or network.
;;; Code:
(require 'vox-test-support)
(require 'vox-ui)

(defvar vox-stop-mode)
(defvar vox-silence-seconds)
(defvar vox-silence-threshold)
(defvar vox-autostop-test-silence-seconds 0.2)

(defun vox-autostop-test--pcm (milliseconds &optional sample)
  "Return synthetic PCM for MILLISECONDS at constant SAMPLE amplitude."
  (let* ((value (or sample 0))
         (pair (unibyte-string (logand value 255) (logand (ash value -8) 255))))
    (apply #'concat (make-list (* 16 milliseconds) pair))))

(defmacro vox-autostop-test--session (mode &rest body)
  "Run BODY with MODE and a synthetic external-audio backend."
  (declare (indent 1) (debug t))
  `(let ((vox--active-session nil) (vox--last-session nil)
         (vox--backends (copy-hash-table vox--backends))
         (vox-stop-mode ,mode) (vox-silence-seconds vox-autostop-test-silence-seconds)
         (vox-silence-threshold 0.01)
         ready emit capture ended session sent commits send-hook
         (stops 0) (finishes 0))
     (vox-register-backend
      'autostop-test
      (list :connect (lambda (_s r e _f) (setq ready r emit e))
            :send-pcm (lambda (_s bytes)
                        (push bytes sent)
                        (when send-hook (funcall send-hook)))
            :finish (lambda (_s) (cl-incf finishes))
            :cancel #'ignore :close #'ignore :needs-external-audio t))
     (cl-letf (((symbol-function 'vox-audio-start)
                (lambda (_s on-bytes on-ended _on-error)
                  (setq capture on-bytes ended on-ended) nil))
               ((symbol-function 'vox-audio-stop) (lambda (_s) (cl-incf stops))))
       (with-temp-buffer
         (unwind-protect
             (progn
               (setq session (vox-core-start
                              'autostop-test
                              (list :on-finish (lambda (_s text) (push text commits)))))
               (funcall ready)
               ,@body)
           (vox-core-cancel))))))

(ert-deftest vox-autostop-drains-before-authoritative-completion ()
  :tags '(vox-unit)
  (vox-autostop-test--session 'silence
    (let ((voice (vox-autostop-test--pcm 100 4096))
          (quiet (vox-autostop-test--pcm 200))
          (tail (vox-autostop-test--pcm 20)))
      (funcall emit '(:type :snapshot :text "final words"))
      (funcall capture voice)
      (funcall capture (substring quiet 0 (* 32 180)))
      (should (eq (vox-session-state session) 'recording))
      (funcall capture (substring quiet (* 32 180)))
      (should (= stops 1))
      (should (eq (vox-session-state session) 'draining))
      (should-not commits)
      (should (= finishes 0))
      (funcall capture tail)
      (funcall ended)
      (should (eq (vox-session-state session) 'finalizing))
      (should (= finishes 1))
      (should-not commits)
      (should (equal (apply #'concat (reverse sent)) (concat voice quiet tail)))
      (funcall emit '(:type :completed))
      (should (equal commits '("final words")))
      (should (eq (vox-session-state session) 'completed))
      (should-not (vox-session-activity session)))))

(ert-deftest vox-autostop-default-and-silent-start ()
  :tags '(vox-unit)
  (should (eq (default-value 'vox-stop-mode) 'silence))
  (should (= (default-value 'vox-silence-seconds) 1.2))
  (vox-autostop-test--session 'silence
    (funcall capture (vox-autostop-test--pcm 500))
    (funcall capture (vox-autostop-test--pcm 80 4096))
    (funcall capture (vox-autostop-test--pcm 300))
    (should (= stops 0))
    (should (eq (vox-session-state session) 'recording))))

(ert-deftest vox-autostop-no-pcm-is-not-silence ()
  :tags '(vox-unit)
  (vox-autostop-test--session 'silence
    (funcall capture (vox-autostop-test--pcm 100 4096))
    (accept-process-output nil 0.25)
    (should (= stops 0))
    (should (eq (vox-session-state session) 'recording))))

(ert-deftest vox-autostop-resumed-speech-without-text-resets-silence ()
  :tags '(vox-unit)
  (vox-autostop-test--session 'silence
    (funcall capture (vox-autostop-test--pcm 100 4096))
    (funcall capture (vox-autostop-test--pcm 180))
    (funcall capture (vox-autostop-test--pcm 20 4096))
    (funcall capture (vox-autostop-test--pcm 180))
    (should (= stops 0))
    (funcall capture (vox-autostop-test--pcm 20))
    (should (= stops 1))
    (should-not commits)))

(ert-deftest vox-autostop-processes-whole-callback-before-stopping ()
  :tags '(vox-unit)
  (vox-autostop-test--session 'silence
    (funcall capture (concat (vox-autostop-test--pcm 100 4096)
                             (vox-autostop-test--pcm 200)
                             (vox-autostop-test--pcm 100 4096)))
    (should (= stops 0))
    (funcall capture (vox-autostop-test--pcm 200))
    (should (= stops 1))))

(ert-deftest vox-autostop-rechecks-after-reentrant-pcm-send ()
  :tags '(vox-unit)
  (vox-autostop-test--session 'silence
    (setq send-hook (lambda ()
                      (setq send-hook nil)
                      (funcall capture (vox-autostop-test--pcm 100 4096))))
    (funcall capture (concat (vox-autostop-test--pcm 100 4096)
                             (vox-autostop-test--pcm 200)))
    (should (= stops 0))
    (should (eq (vox-session-state session) 'recording))
    (funcall capture (vox-autostop-test--pcm 200))
    (should (= stops 1))))

(ert-deftest vox-autostop-manual-mode-bypasses-detector ()
  :tags '(vox-unit)
  (vox-autostop-test--session 'manual
    (cl-letf (((symbol-function 'vox-activity-feed)
               (lambda (&rest _) (ert-fail "Manual mode analyzed PCM"))))
      (funcall capture (concat (vox-autostop-test--pcm 100 4096)
                               (vox-autostop-test--pcm 500))))
    (should-not (vox-session-activity session))
    (should (eq (vox-session-stop-mode session) 'manual))
    (should (= stops 0))
    (vox-core-stop)
    (should (= stops 1))))

(ert-deftest vox-autostop-self-recording-backend-is-explicitly-manual ()
  :tags '(vox-unit)
  (let ((vox-stop-mode 'silence))
    (vox-test-session
      (funcall ready)
      (should (eq (vox-session-stop-mode session) 'manual))
      (should-not (vox-session-activity session))
      (funcall emit '(:type :segment-final :id "one" :text "not a stop signal"))
      (should (eq (vox-session-state session) 'recording))
      (should-not commits))))

(ert-deftest vox-autostop-cancel-and-old-callbacks-cannot-stop-new-session ()
  :tags '(vox-unit)
  (vox-autostop-test--session 'silence
    (funcall capture (vox-autostop-test--pcm 100 4096))
    (let ((old-capture capture) (old-session session))
      (vox-core-cancel)
      (should-not (vox-session-activity old-session))
      (setq session (vox-core-start 'autostop-test nil))
      (funcall ready)
      (funcall old-capture (vox-autostop-test--pcm 300))
      (funcall capture (vox-autostop-test--pcm 300))
      (should (= stops 0))
      (should (eq (vox-session-state session) 'recording))
      (should-not commits))))

(ert-deftest vox-autostop-settings-are-captured-at-start ()
  :tags '(vox-unit)
  (vox-autostop-test--session 'silence
    (setq vox-stop-mode 'manual vox-silence-seconds 10 vox-silence-threshold 1)
    (funcall capture (concat (vox-autostop-test--pcm 100 4096)
                             (vox-autostop-test--pcm 200)))
    (should (= stops 1))
    (should (eq (vox-session-stop-mode session) 'silence))))

(ert-deftest vox-autostop-default-sink-inserts-only-after-completion ()
  :tags '(vox-unit)
  (vox-autostop-test--session 'silence
    (insert "prefix|")
    (setf (vox-session-sink session) (vox-make-buffer-sink))
    (funcall emit '(:type :snapshot :text "VOICE"))
    (funcall capture (concat (vox-autostop-test--pcm 100 4096)
                             (vox-autostop-test--pcm 200)))
    (should (equal (buffer-string) "prefix|"))
    (funcall ended)
    (should (equal (buffer-string) "prefix|"))
    (funcall emit '(:type :completed))
    (should (equal (buffer-string) "prefix|VOICE"))))

(ert-deftest vox-autostop-invalid-settings-fail-before-connecting ()
  :tags '(vox-unit)
  (dolist (setting '((vox-stop-mode unknown) (vox-silence-seconds 0.1)
                     (vox-silence-seconds 11) (vox-silence-threshold 0)
                     (vox-silence-threshold "quiet")))
    (let ((vox--active-session nil) (vox-stop-mode 'silence)
          (vox-silence-seconds 1.2) (vox-silence-threshold 0.01) connected)
      (cl-letf (((symbol-function 'vox-backend-methods)
                 (lambda (_ &optional _model)
                   (list :needs-external-audio t
                         :connect (lambda (&rest _) (setq connected t))))))
        (cl-progv (list (car setting)) (list (cadr setting))
          (should-error (vox-core-start 'autostop-test nil) :type 'user-error))
        (should-not connected)
        (should-not vox--active-session)))))

(ert-deftest vox-autostop-error-retains-text-without-insertion ()
  :tags '(vox-unit)
  (vox-autostop-test--session 'silence
    (funcall emit '(:type :snapshot :text "unconfirmed"))
    (funcall capture (concat (vox-autostop-test--pcm 100 4096)
                             (vox-autostop-test--pcm 200)))
    (funcall emit '(:type :error))
    (funcall ended)
    (should (eq (vox-session-state session) 'error))
    (should-not (vox-session-activity session))
    (should (equal (vox-session-text session) "unconfirmed"))
    (should-not commits)))

(ert-deftest vox-autostop-queue-overflow-precedes-analysis ()
  :tags '(vox-unit)
  (vox-autostop-test--session 'silence
    (setf (vox-session-queue-limit session) 10)
    (let ((analyzed nil))
      (cl-letf (((symbol-function 'vox-activity-feed)
                 (lambda (&rest _) (setq analyzed t))))
        (funcall capture (vox-autostop-test--pcm 100 4096)))
      (should-not analyzed))
    (should (eq (vox-session-state session) 'error))
    (should-not (vox-session-activity session))
    (should (= stops 0))
    (should-not commits)))

(ert-deftest vox-autostop-ui-reports-effective-recording-mode ()
  :tags '(vox-unit)
  (dolist (mode '(silence manual))
    (vox-autostop-test--session mode
      (let ((noninteractive nil) status
            (notify (plist-get (vox-make-buffer-sink) :on-state)))
        (cl-letf (((symbol-function 'message)
                   (lambda (format-string &rest args)
                     (setq status (apply #'format format-string args)))))
          (funcall notify session 'recording))
        (should (string-match-p (if (eq mode 'silence) "pause to finish" "manual stop")
                                status))))))

(ert-deftest vox-autostop-default-delay-drains-past-one-pump-budget ()
  :tags '(vox-unit)
  (let ((vox-autostop-test-silence-seconds 1.2))
    (vox-autostop-test--session 'silence
      (let ((pcm (concat (vox-autostop-test--pcm 100 4096)
                         (vox-autostop-test--pcm 1200))))
        (funcall capture pcm)
        (should (= stops 1))
        (should (= (length sent) 8))
        (should (= finishes 0))
        (should (eq (vox-session-state session) 'draining))
        (let ((timer (vox-session-audio-timer session)))
          (should (timerp timer))
          (cancel-timer timer)
          (apply (timer--function timer) (timer--args timer)))
        (should (= (length sent) 13))
        (should (= finishes 0))
        (funcall ended)
        (funcall ended)
        (should (= finishes 1))
        (should (equal (apply #'concat (reverse sent)) pcm))))))

(ert-deftest vox-autostop-send-reentrancy-can-cancel-or-fail ()
  :tags '(vox-unit)
  (dolist (terminal '(cancelled error))
    (vox-autostop-test--session 'silence
      (setq send-hook (lambda ()
                        (setq send-hook nil)
                        (if (eq terminal 'cancelled)
                            (vox-core-cancel session)
                          (vox-core-fail session "Synthetic send failure"))))
      (funcall capture (concat (vox-autostop-test--pcm 100 4096)
                               (vox-autostop-test--pcm 200)))
      (should (eq (vox-session-state session) terminal))
      (should (= stops 0))
      (should (= finishes 0))
      (should-not commits)
      (should-not (vox-session-activity session)))))

(provide 'vox-test-autostop)
