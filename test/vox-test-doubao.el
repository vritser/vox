;;; vox-test-doubao.el --- SeedASR binary tests -*- lexical-binding: t; no-byte-compile: t; -*-
(require 'vox-test-support)
(require 'cl-lib)
(require 'vox-backend-doubao)

(defconst vox-doubao-test--fixtures
  (expand-file-name "fixtures" (file-name-directory (or load-file-name buffer-file-name))))

(defun vox-doubao-test--fixture (name)
  "Read synthetic fixture NAME literally."
  (with-temp-buffer
    (set-buffer-multibyte nil)
    (insert-file-contents-literally (expand-file-name name vox-doubao-test--fixtures))
    (buffer-string)))

(defun vox-doubao-test--response (flags payload &optional seq event)
  "Build a synthetic uncompressed server response, not a captured packet."
  (let ((bytes (encode-coding-string (vox-json-encode payload) 'utf-8-unix)))
    (concat (unibyte-string #x11 (logior #x90 flags) #x10 0)
            (if (/= (logand flags 1) 0) (vox-doubao--uint32 (or seq 1)) "")
            (if (/= (logand flags 4) 0) (vox-doubao--uint32 (or event 0)) "")
            (vox-doubao--uint32 (length bytes)) bytes)))

(ert-deftest vox-doubao-crc-and-gzip-known-vectors ()
  :tags '(vox-unit)
  (should (= (vox-doubao--crc32 "123456789") #xcbf43926))
  (should (= (vox-doubao--crc32 "") 0))
  (should (equal (vox-doubao-gzip "")
                 (unibyte-string 31 139 8 0 0 0 0 0 0 255
                                 1 0 0 255 255 0 0 0 0 0 0 0 0)))
  (dolist (size '(0 1 2 255 256 3200 6400 65534 65535 65536 131070 131071))
    (let ((input (make-string size 0)))
      (dotimes (i size) (aset input i (% i 256)))
      (let ((gzip (vox-doubao-gzip input)))
        (should-not (multibyte-string-p gzip))
        (should (= (vox-doubao--read-u32 gzip (- (length gzip) 4) t) size))
        (should (equal input (vox-doubao--gunzip gzip)))))))

(ert-deftest vox-doubao-client-wire-header-and-sequence ()
  :tags '(vox-unit)
  (let ((full (vox-doubao-encode 1 1 "{}"))
        (audio (vox-doubao-encode 2 2 (unibyte-string 128 255)))
        (last (vox-doubao-encode 2 3 (unibyte-string 0 1) t)))
    (should (equal (substring full 0 8) (unibyte-string #x11 #x11 #x11 0 0 0 0 1)))
    (should (equal (substring audio 0 8) (unibyte-string #x11 #x21 #x11 0 0 0 0 2)))
    (should (equal (substring last 0 8) (unibyte-string #x11 #x23 #x11 0 255 255 255 253)))
    (dolist (frame (list full audio last))
      (should (= (vox-doubao--read-u32 frame 8) (- (length frame) 12))))
    (should (equal (vox-doubao--gunzip (substring full 12)) "{}"))
    (should (equal (vox-doubao--gunzip (substring audio 12)) (unibyte-string 128 255)))
    (should (equal (vox-doubao--gunzip (substring last 12)) (unibyte-string 0 1))))
  (should-error (vox-doubao-encode 1 0 "{}"))
  (should-error (vox-doubao-encode 1 1 "{}" t))
  (should-error (vox-doubao-encode 2 #x80000000 ""))
  (should-error (vox-doubao-gzip (string #x4e2d))))

(ert-deftest vox-doubao-synthetic-fixture-decode ()
  :tags '(vox-unit)
  (let ((ready (vox-doubao-decode (vox-doubao-test--fixture "doubao-ready.bin")))
        (partial (vox-doubao-decode (vox-doubao-test--fixture "doubao-partial.bin")))
        (final (vox-doubao-decode (vox-doubao-test--fixture "doubao-final.bin"))))
    (should (= (plist-get ready :sequence) 1))
    (should-not (plist-get ready :last-p))
    (should (equal (plist-get (vox-doubao-normalize partial 1) :text) "Check emacs"))
    (should (= (plist-get final :sequence) -3))
    (should (= (plist-get final :event) 100))
    (should (plist-get final :last-p))
    (should (equal (vox-doubao-normalize final 2)
                   '(:type :snapshot :text "Check Emacs Lisp." :revision 2 :final-p t)))))

(ert-deftest vox-doubao-flags-and-extended-header ()
  :tags '(vox-unit)
  (dotimes (flags 8)
    (let ((packet (vox-doubao-decode
                   (vox-doubao-test--response flags '(:result (:text "x")) -7 99))))
      (should (eq (plist-get packet :last-p) (/= (logand flags 2) 0)))
      (should (equal (plist-get packet :sequence) (and (/= (logand flags 1) 0) -7)))
      (should (equal (plist-get packet :event) (and (/= (logand flags 4) 0) 99)))))
  (let* ((original (vox-doubao-test--fixture "doubao-ready.bin"))
         (extended (concat (unibyte-string #x12) (substring original 1 4)
                           (unibyte-string 0 0 0 0) (substring original 4))))
    (should (= (plist-get (vox-doubao-decode extended) :sequence) 1))))

(ert-deftest vox-doubao-reject-corrupt-frames ()
  :tags '(vox-unit)
  (let ((frame (vox-doubao-test--fixture "doubao-final.bin")))
    (dotimes (length (length frame))
      (should-error (vox-doubao-decode (substring frame 0 length))))
    (should-error (vox-doubao-decode (concat frame frame)))
    (dolist (edit '((0 . 33) (0 . 16) (1 . 128) (1 . 152) (2 . 18) (3 . 1)))
      (let ((copy (copy-sequence frame)))
        (aset copy (car edit) (cdr edit))
        (should-error (vox-doubao-decode copy))))
    (let ((copy (copy-sequence frame)))
      (aset copy 12 127)
      (should-error (vox-doubao-decode copy))))
  (should-error (vox-doubao-decode (unibyte-string #x11 #x90 #x10 0 0 32 0 0)))
  (should-error (vox-doubao--gunzip "bad"))
  (let ((gzip (vox-doubao-gzip "abc")))
    (aset gzip (- (length gzip) 4) 0)
    (should-error (vox-doubao--gunzip gzip))))

(ert-deftest vox-doubao-error-and-body-flags-not-completion ()
  :tags '(vox-unit)
  (let ((event (vox-doubao-normalize
                (vox-doubao-decode (vox-doubao-test--fixture "doubao-error.bin")) 1)))
    (should (eq (plist-get event :type) :error))
    (should-not (string-match-p "SYNTHETIC SECRET" (prin1-to-string event))))
  (let ((packet (vox-doubao-decode
                 (vox-doubao-test--response
                  0 '(:is_last_package t :result (:text "x" :utterances [(:definite t)]))))))
    (should-not (plist-get packet :last-p))
    (should-not (plist-get (vox-doubao-normalize packet 1) :final-p))))

(ert-deftest vox-doubao-request-config ()
  :tags '(vox-unit)
  (let* ((vox-doubao-second-pass nil)
         (request (plist-get (vox-json-read (vox-json-encode (vox-doubao-config))) :request)))
    (should (equal (plist-get request :model_name) "bigmodel"))
    (should (equal (plist-get request :result_type) "full"))
    (should (eq (plist-get request :enable_nonstream) :false)))
  (should (plist-get (vox-backend-methods 'doubao) :experimental)))

(ert-deftest vox-doubao-connect-ready-held-last-frame-and-complete ()
  :tags '(vox-unit)
  (let ((session (vox--make-session :id "test" :generation 1))
        callbacks headers sent events errors (ready 0) (closed 0))
    (cl-letf (((symbol-function 'vox-secret) (lambda (&rest _) "test-secret"))
              ((symbol-function 'vox-transport-open)
               (lambda (_session _url h open message error close)
                 (setq headers h callbacks (list open message error close))))
              ((symbol-function 'vox-transport-send-binary)
               (lambda (_session bytes) (push bytes sent)))
              ((symbol-function 'vox-transport-close) (lambda (_) (cl-incf closed))))
      (vox-doubao-connect session (lambda () (cl-incf ready))
                          (lambda (e) (push e events)) (lambda (e) (push e errors)))
      (should (equal (cdr (assoc "X-Api-Key" headers)) "test-secret"))
      (should (equal (cdr (assoc "X-Api-Resource-Id" headers)) "volc.seedasr.sauc.duration"))
      (should (string-match-p "\\`[[:xdigit:]-]\\{36\\}\\'"
                              (cdr (assoc "X-Api-Request-Id" headers))))
      (funcall (nth 0 callbacks))
      (should (= ready 0))
      (should (= (length sent) 1))
      (funcall (nth 1 callbacks) (vox-doubao-test--fixture "doubao-ready.bin") 'binary)
      (should (= ready 1))
      (vox-doubao-send-pcm session (unibyte-string 0 128))
      (should (= (length sent) 1))
      (vox-doubao-send-pcm session (unibyte-string 255 0))
      (should (= (length sent) 2))
      (should (equal (vox-doubao--gunzip (substring (car sent) 12)) (unibyte-string 0 128)))
      (vox-doubao-finish session) (vox-doubao-finish session)
      (should (= (length sent) 3))
      (should (= (aref (car sent) 1) #x23))
      (should (= (vox-doubao--read-u32 (car sent) 4) #xfffffffd))
      (should (equal (vox-doubao--gunzip (substring (car sent) 12)) (unibyte-string 255 0)))
      (funcall (nth 1 callbacks) (vox-doubao-test--fixture "doubao-partial.bin") 'binary)
      (funcall (nth 1 callbacks) (vox-doubao-test--fixture "doubao-final.bin") 'binary)
      (funcall (nth 1 callbacks) (vox-doubao-test--fixture "doubao-final.bin") 'binary)
      (should (equal (mapcar (lambda (e) (plist-get e :type)) (reverse events))
                     '(:snapshot :snapshot :completed)))
      (funcall (nth 3 callbacks))
      (should-not errors)
      (vox-doubao-close session) (vox-doubao-close session)
      (should (= closed 1)))))

(ert-deftest vox-doubao-premature-end-and-disconnect-are-errors ()
  :tags '(vox-unit)
  (let ((session (vox--make-session :id "test" :generation 1)) callbacks errors events)
    (cl-letf (((symbol-function 'vox-secret) (lambda (&rest _) "test"))
              ((symbol-function 'vox-transport-open)
               (lambda (_s _u _h _o message _error close)
                 (setq callbacks (list message close)))))
      (vox-doubao-connect session #'ignore (lambda (e) (push e events))
                          (lambda (e) (push e errors))))
    (funcall (car callbacks) (vox-doubao-test--fixture "doubao-final.bin") 'binary)
    (funcall (cadr callbacks))
    (should (= (length errors) 2))
    (should-not events)))

(ert-deftest vox-doubao-cancel-discards-pending-and-empty-finish ()
  :tags '(vox-unit)
  (let ((session (vox--make-session :backend-state '(:ready t :sequence 2))) sent)
    (cl-letf (((symbol-function 'vox-transport-send-binary)
               (lambda (_ bytes) (push bytes sent)))
              ((symbol-function 'vox-transport-close) #'ignore))
      (vox-doubao-send-pcm session (unibyte-string 1 2))
      (vox-doubao-close session)
      (vox-doubao-finish session)
      (should-not sent)
      (should-not (plist-get (vox-session-backend-state session) :pending)))
    (setf (vox-session-backend-state session) '(:ready t :sequence 2))
    (cl-letf (((symbol-function 'vox-transport-send-binary)
               (lambda (_ bytes) (push bytes sent))))
      (vox-doubao-finish session)
      (should (equal (vox-doubao--gunzip (substring (car sent) 12)) "")))))

(ert-deftest vox-doubao-empty-final-payload ()
  :tags '(vox-unit)
  ;; Both official parsers return before gzip/JSON when payload size is zero.
  (let* ((bytes (unibyte-string #x11 #x93 #x11 0 255 255 255 253 0 0 0 0))
         (packet (vox-doubao-decode bytes))
         events
         (session (vox--make-session
                   :backend-state (list :ready t :finished t
                                        :on-event (lambda (e) (push e events))))))
    (should (plist-get packet :last-p))
    (should-not (plist-get packet :payload))
    (vox-doubao--message session bytes 'binary)
    (should (equal events '((:type :completed))))))

(provide 'vox-test-doubao)
