(ert-deftest vox-doubao-cancel-discards-pending-and-empty-finish ()
  :tags '(vox-unit)
  (let ((session (vox--make-session :backend-state '(:ready t :sequence 2))) sent)
    (cl-letf (((symbol-function 'vox-transport-send-binary)
               (lambda (_ bytes) (push bytes sent)))
              ((symbol-function 'vox-transport-close) #'ignore))
      (vox-doubao-send-pcm session (unibyte-string 1 2))
      (vox-doubao-close session)
      (vox-doubao-finish session)
      (should-not sent)
      (should-not (plist-get (vox-session-backend-state session) :pending)))
    (setf (vox-session-backend-state session) '(:ready t :sequence 2))
    (cl-letf (((symbol-function 'vox-transport-send-binary)
               (lambda (_ bytes) (push bytes sent))))
      (vox-doubao-finish session)
      (should (equal (vox-doubao--gunzip (substring (car sent) 12)) "")))))

(ert-deftest vox-doubao-empty-final-payload ()
  :tags '(vox-unit)
  ;; Both official parsers return before gzip/JSON when payload size is zero.
  (let* ((bytes (unibyte-string #x11 #x93 #x11 0 255 255 255 253 0 0 0 0))
         (packet (vox-doubao-decode bytes))
         events
         (session (vox--make-session
                   :backend-state (list :ready t :finished t
                                        :on-event (lambda (e) (push e events))))))
    (should (vox-doubao-packet-last-p packet))
    (should-not (vox-doubao-packet-payload packet))
    (vox-doubao--message session bytes 'binary)
    (should (equal events '((:type :completed))))))

(ert-deftest vox-doubao-reentrant-startup-cancel-prevents-secret-and-transport ()
  :tags '(vox-unit)
  (dolist (boundary '(approval key))
    (let* ((vox--active-session nil) (vox--last-session nil)
           (vox-asr-selection nil) (noninteractive nil) order opened
           (backend (vox-test-make-doubao
                     "cancel" :host "doubao.example"
                     :key (lambda ()
                            (push 'key order)
                            (when (eq boundary 'key) (vox-core-cancel))
                            "synthetic-key"))))
      (cl-letf (((symbol-function 'yes-or-no-p)
                 (lambda (_)
                   (push 'approval order)
                   (when (eq boundary 'approval) (vox-core-cancel))
                   t))
                ((symbol-function 'vox-transport-open)
                 (lambda (&rest _) (setq opened t)))
                ((symbol-function 'vox-transport-close) #'ignore)
                ((symbol-function 'vox-audio-start)
                 (lambda (&rest _) (ert-fail "Cancelled startup must not record")))
                ((symbol-function 'vox-audio-cancel) #'ignore))
        (with-temp-buffer
          (unwind-protect
              (let ((session (vox-core-start backend nil)))
                (should (eq (vox-session-state session) 'cancelled))
                (should (vox-session-cleaned session))
                (should-not (vox-session-backend-state session))
                (should-not (vox-session-connect-timer session))
                (should-not (vox-current-session))
                (should (eq vox--last-session session))
                (should-not opened)
                (should (equal (reverse order)
                               (if (eq boundary 'approval) '(approval)
                                 '(approval key)))))
            (vox-core-cancel)))))))

(ert-deftest vox-doubao-reentrant-send-cancel-keeps-cleanup-final ()
  :tags '(vox-unit)
  (dolist (finishing '(nil t))
    (let* ((vox--last-session nil)
           (session (vox--make-session
                     :generation 1 :state 'recording
                     :methods (list :cancel #'vox-doubao-close :close #'vox-doubao-close)
                     :backend-state (list :ready t :sequence 2)))
           (vox--active-session session)
           sent)
      (unwind-protect
          (cl-letf (((symbol-function 'vox-transport-close) #'ignore)
                    ((symbol-function 'vox-transport-send-binary)
                     (lambda (_session bytes)
                       (push bytes sent)
                       (vox-core-cancel session))))
            (vox-doubao-send-pcm session (unibyte-string 1 2))
            (if finishing
                (vox-doubao-finish session)
              (vox-doubao-send-pcm session (unibyte-string 3 4)))
            (should (= (length sent) 1))
            (should (equal (vox-doubao--gunzip (substring (car sent) 12))
                           (unibyte-string 1 2)))
            (should (eq (vox-session-state session) 'cancelled))
            (should (vox-session-cleaned session))
            (should-not (vox-session-backend-state session))
            (should-not (vox-current-session)))
        (vox-core-cancel session)))))

(ert-deftest vox-doubao-final-callback-failure-does-not-resurrect-state ()
  :tags '(vox-unit)
  (let* ((vox--last-session nil)
         (session (vox--make-session
                   :generation 1 :state 'finalizing
                   :methods (list :cancel #'ignore :close #'ignore))))
    (setf (vox-session-backend-state session)
          (list :ready t :finished t
                :on-event (lambda (_event)
                            (vox-core-fail session "synthetic" 'provider))
                :on-error #'ignore))
    (setq vox--active-session session)
    (cl-letf (((symbol-function 'vox-doubao-decode)
               (lambda (_payload) (vox-doubao--make-packet :last-p t)))
              ((symbol-function 'vox-doubao-normalize)
               (lambda (_packet _revision)
                 '(:type :snapshot :text "synthetic"))))
      (vox-doubao--message session (unibyte-string 1) 'binary)
      (should (eq (vox-session-state session) 'error))
      (should (vox-session-cleaned session))
      (should-not (vox-session-backend-state session)))))

