(require 'vox-test-support)
(require 'vox)

(ert-deftest vox-provider-shares-host-and-lazy-key-across-capabilities ()
  :tags '(vox-unit)
  (let* ((calls 0) (key (lambda () (cl-incf calls) "synthetic"))
         (provider (vox-make-qwen "Shared" :host "proxy.example" :key key
                                  :asr '(:models (asr-model))
                                  :tts '(:models (tts-model) :voice "Cherry")))
         (asr (vox-backend-capability provider 'asr))
         (tts (vox-backend-capability provider 'tts)))
    (should (vox-provider-p provider))
    (should (eq (vox-backend-type asr) 'qwen))
    (should (eq (vox-backend-type tts) 'tts-qwen-realtime))
    (should (equal (vox-backend-host asr) "proxy.example"))
    (should (equal (vox-backend-host tts) "proxy.example"))
    (should (equal (vox-backend-endpoint asr) "/api-ws/v1/realtime"))
    (should (equal (vox-backend-endpoint tts) "/api-ws/v1/realtime"))
    (should (equal (vox-backend-models asr) '("asr-model")))
    (should (equal (vox-backend-models tts) '("tts-model")))
    (should (eq (vox-backend-key asr) key))
    (should (eq (vox-backend-key tts) key))
    (should (= calls 0))))

(ert-deftest vox-provider-overrides-and-explicit-nil-key ()
  :tags '(vox-unit)
  (let* ((provider (vox-make-qwen
                    "Shared" :key "shared-synthetic"
                    :asr '(:protocol qwen-audio :language "en")
                    :tts '(:host "tts.example" :endpoint "/speech" :key nil)))
         (asr (vox-backend-capability provider 'asr))
         (tts (vox-backend-capability provider 'tts)))
    (should (eq (vox-backend-type asr) 'qwen-audio))
    (should (equal (vox-backend-endpoint asr) "/api-ws/v1/inference"))
    (should (equal (vox-backend-language asr) "en"))
    (should (equal (vox-backend-key asr) "shared-synthetic"))
    (should (equal (vox-backend-host tts) "tts.example"))
    (should (equal (vox-backend-endpoint tts) "/speech"))
    (should-not (vox-backend-key tts))
    (cl-letf (((symbol-function 'vox-api-key-from-auth-source)
               (lambda (host) (should (equal host "tts.example")) "host-specific")))
      (should (equal (vox-backend-secret tts "tts.example") "host-specific")))))

(ert-deftest vox-provider-doubao-resources-are-independent ()
  :tags '(vox-unit)
  (let* ((provider (vox-make-doubao "D" :asr '(:resource-id "asr.resource")
                                    :tts '(:resource-id "tts.resource" :voice "speaker")))
         (asr (vox-backend-capability provider 'asr))
         (tts (vox-backend-capability provider 'tts)))
    (should (equal (vox-backend-resource-id asr) "asr.resource"))
    (should (equal (vox-backend-resource-id tts) "tts.resource"))
    (should (equal (vox-backend-models tts) '("tts.resource")))
    (should (equal (vox-backend-voice tts) "speaker"))))

(ert-deftest vox-provider-snapshot-detaches-both-capabilities ()
  :tags '(vox-unit)
  (let* ((language (copy-sequence "en")) (voice (copy-sequence "Cherry"))
         (provider (vox-make-qwen "Q" :asr (list :language language)
                                  :tts (list :voice voice)))
         (snapshot (vox-backend-snapshot provider))
         (asr (vox-backend-capability provider 'asr))
         (tts (vox-backend-capability provider 'tts)))
    (aset language 0 ?X)
    (aset voice 0 ?Y)
    (aset (plist-get (vox-provider-asr provider) :language) 0 ?Z)
    (aset (plist-get (vox-provider-tts provider) :voice) 0 ?Z)
    (setf (vox-provider-host provider) "changed.example")
    (should (equal (vox-backend-language asr) "en"))
    (should (equal (vox-backend-voice tts) "Cherry"))
    (should (equal (vox-backend-host tts) "dashscope.aliyuncs.com"))
    (should (equal (plist-get (vox-provider-asr snapshot) :language) "en"))
    (should (equal (plist-get (vox-provider-tts snapshot) :voice) "Cherry"))))

(ert-deftest vox-provider-selection-filters-capability-and-keeps-independent-choices ()
  :tags '(vox-unit)
  (let ((vox-backends (list (vox-make-qwen "Output" :asr nil :tts t)
                            (vox-make-qwen "Input")
                            (vox-make-doubao "Both" :tts t)))
        (vox-asr-selection nil) (vox-tts-selection nil))
    (should (equal (mapcar #'car (vox--backend-candidates)) '("Input" "Both")))
    (should (equal (mapcar #'car (vox--backend-candidates 'tts)) '("Output" "Both")))
    (should (equal (vox-backend-name (car (vox--resolve-selection))) "Input"))
    (should (equal (vox-backend-name (car (vox-tts--resolve))) "Output"))
    (setq vox-asr-selection '("Input" qwen3-asr-flash-realtime)
          vox-tts-selection '("Both" seed-tts-2.0))
    (should (equal (cdr (vox--resolve-selection)) "qwen3-asr-flash-realtime"))
    (should (equal (cdr (vox-tts--resolve)) "seed-tts-2.0"))
    (setq vox-asr-selection '("Output" nil))
    (should-error (vox--resolve-selection) :type 'user-error)
    (setq vox-tts-selection '("Input" nil))
    (should-error (vox-tts--resolve) :type 'user-error)))

(ert-deftest vox-provider-duplicate-names-and-invalid-unused-capability-block-selection ()
  :tags '(vox-unit)
  (let ((vox-backends (list (vox-make-qwen "Duplicate") (vox-make-qwen "Duplicate" :asr nil :tts t))))
    (should-error (vox--backend-candidates) :type 'user-error)
    (should-error (vox--backend-candidates 'tts) :type 'user-error))
  (let* ((provider (vox-make-qwen "Shared" :tts t)) (vox-backends (list provider)))
    (setf (vox-provider-tts provider) '(:protocol tts-qwen-realtime :voice "bad\nvoice"))
    (should-error (vox--backend-candidates) :type 'user-error)))

(ert-deftest vox-provider-rejects-ambiguous-and-mismatched-capability-options ()
  :tags '(vox-unit)
  (dolist (asr '((:models (first) :models (second)) (:protocol tts-qwen-realtime)
                 (:typo t) (:voice "Cherry") (:models) bad))
    (should-error (vox-make-qwen "Q" :asr asr) :type 'user-error))
  (should-error (vox-make-qwen "Q" :asr nil) :type 'user-error)
  (should-error (vox-make-cli "Empty") :type 'user-error)
  (should-error (vox-make-cli "Bad" :tts '(:command ("program" 7))) :type 'user-error)
  (let ((cycle (list 'model)))
    (setcdr cycle cycle)
    (should-error (vox-make-qwen "Cycle" :asr (list :models cycle)) :type 'user-error)))

(ert-deftest vox-provider-asr-picker-detects-tts-config-change ()
  :tags '(vox-unit)
  (let* ((provider (vox-make-qwen "Q" :tts t)) (vox-backends (list provider))
         (vox-asr-selection nil) (vox--selection-revision 0))
    (cl-letf (((symbol-function 'completing-read)
               (lambda (&rest _)
                 (setf (vox-provider-tts provider) '(:protocol tts-qwen-realtime :voice "Changed"))
                 "\"Q\" / \"qwen3-asr-flash-realtime\"")))
      (should-error (vox-asr-select) :type 'user-error))
    (should-not vox-asr-selection)))

(ert-deftest vox-provider-tts-picker-is-pure-and-detects-asr-config-change ()
  :tags '(vox-unit)
  (let* ((keys 0) (provider (vox-make-qwen "Q" :key (lambda () (cl-incf keys)) :tts t))
         (vox-backends (list provider)) (vox-tts-selection nil)
         (vox-tts--selection-revision 0))
    (cl-letf (((symbol-function 'completing-read)
               (lambda (_prompt choices &rest _)
                 (should (equal choices '(("\"Q\" / \"qwen3-tts-flash-realtime\"" "Q" "qwen3-tts-flash-realtime"))))
                 "\"Q\" / \"qwen3-tts-flash-realtime\"")))
      (should (equal (vox-tts-select) '("Q" "qwen3-tts-flash-realtime"))))
    (should (= keys 0))
    (cl-letf (((symbol-function 'completing-read)
               (lambda (&rest _)
                 (setf (vox-provider-asr provider) '(:protocol qwen :language "en"))
                 "\"Q\" / \"qwen3-tts-flash-realtime\"")))
      (should-error (vox-tts-select) :type 'user-error))
    (should (equal vox-tts-selection '("Q" "qwen3-tts-flash-realtime")))))

(ert-deftest vox-provider-cli-keeps-separate-captured-argv ()
  :tags '(vox-unit)
  (let* ((provider (vox-make-cli "Local" :asr '(:command ("asr-program" "--ndjson"))
                                 :tts '(:command ("tts-program" "--stdout"))))
         (vox-backends (list provider))
         (vox-asr-selection '("Local" nil)) (vox-tts-selection '("Local" nil))
         (asr (car (vox--resolve-selection))) (tts (car (vox-tts--resolve))))
    (should (eq (vox-backend-type asr) 'cli))
    (should (eq (vox-backend-type tts) 'tts-cli))
    (should (equal (vox-backend-command asr) '("asr-program" "--ndjson")))
    (should (equal (vox-backend-command tts) '("tts-program" "--stdout")))
    (should-not (cdr (vox--resolve-selection)))
    (should-not (cdr (vox-tts--resolve)))
    (setf (vox-provider-asr provider) '(:protocol cli :command ("changed")))
    (should (equal (vox-backend-command asr) '("asr-program" "--ndjson")))
    (should-not (plist-get (vox-backend-methods asr) :needs-external-audio))
    (should-error (vox-backend-methods asr 'model) :type 'user-error)))

(ert-deftest vox-provider-named-asr-cli-runs-captured-command ()
  :tags '(vox-unit)
  (let* ((command (list "sh" (expand-file-name "support/vox-cli.sh" vox-test-directory) "0"))
         (provider (vox-make-cli "Local" :asr (list :command command)))
         (vox--active-session nil) (vox--last-session nil)
         (vox-cli-command '("sh" "-c" "exit 9"))
         session committed)
    (with-temp-buffer
      (unwind-protect
          (progn
            (setq session (vox-core-start provider
                                          (list :on-finish (lambda (_session text)
                                                             (setq committed text)))))
            (setf (vox-provider-asr provider) '(:protocol cli :command ("changed")))
            (should (equal (process-command (plist-get (vox-session-backend-state session) :process))
                           command))
            (let ((deadline (+ (float-time) 3)))
              (while (and (eq (vox-session-state session) 'connecting) (< (float-time) deadline))
                (accept-process-output nil 0.01)))
            (should (eq (vox-session-state session) 'recording))
            (vox-core-stop)
            (let ((deadline (+ (float-time) 3)))
              (while (and (vox--live-p session) (< (float-time) deadline))
                (accept-process-output nil 0.01)))
            (should (eq (vox-session-state session) 'completed))
            (should (equal committed "synthetic CLI")))
        (vox-core-cancel)))))

(ert-deftest vox-provider-doctor-skips-network-fields-for-named-cli ()
  :tags '(vox-unit)
  (let ((vox-backends (list (vox-make-cli "Local" :asr '(:command ("sh")))))
        (vox-asr-selection '("Local" nil)))
    (let ((context (vox-doctor--context)))
      (should (eq (plist-get (vox-doctor--selection context) :status) 'ok))
      (should (eq (plist-get (vox-doctor--endpoint context) :status) 'skip))
      (should (eq (plist-get (vox-doctor--key context) :status) 'skip)))))

(provide 'vox-test-provider)
