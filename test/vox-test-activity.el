;;; vox-test-activity.el --- Synthetic PCM activity tests -*- lexical-binding: t; no-byte-compile: t; -*-

;; SPDX-License-Identifier: GPL-3.0-or-later
;;; Commentary:
;; All audio here is synthetic PCM16LE, not microphone/provider evidence.
;;; Code:

(require 'vox-test-support)
(require 'vox-activity)

(defun vox-activity-test--pcm (sample count)
  "Return COUNT synthetic signed PCM16LE samples with value SAMPLE."
  (let ((bytes (make-string (* 2 count) 0))
        (word (logand sample #xffff)))
    (dotimes (index count)
      (aset bytes (* 2 index) (logand word 255))
      (aset bytes (1+ (* 2 index)) (ash word -8)))
    bytes))

(defun vox-activity-test--windows (sample windows)
  "Return WINDOWS synthetic 20ms windows of SAMPLE."
  (vox-activity-test--pcm sample (* windows 320)))

(ert-deftest vox-activity-starting-silence-never-stops ()
  :tags '(vox-unit)
  (let ((state (vox-activity-create 0.01 1.2)))
    (should-not (vox-activity-feed state (vox-activity-test--windows 0 100)))
    (should-not (vox-activity--armed state))))

(ert-deftest vox-activity-short-click-does-not-arm ()
  :tags '(vox-unit)
  (let ((state (vox-activity-create 0.01 1.2)))
    (dotimes (_ 3)
      (should-not (vox-activity-feed state (vox-activity-test--windows 1200 4)))
      (should-not (vox-activity-feed state (vox-activity-test--windows 0 60))))
    (should-not (vox-activity--armed state))))

(ert-deftest vox-activity-exact-arm-and-silence-boundaries ()
  :tags '(vox-unit)
  (let ((state (vox-activity-create 0.01 1.2)))
    (should-not (vox-activity-feed state (vox-activity-test--windows 1200 4)))
    (should-not (vox-activity--armed state))
    (should-not (vox-activity-feed state (vox-activity-test--windows 1200 1)))
    (should (vox-activity--armed state))
    (should-not (vox-activity-feed state (vox-activity-test--windows 0 59)))
    (should-not (vox-activity-feed state (vox-activity-test--pcm 0 319)))
    (should (vox-activity-feed state (vox-activity-test--pcm 0 1)))))

(ert-deftest vox-activity-resumed-voice-resets-silence ()
  :tags '(vox-unit)
  (let ((state (vox-activity-create 0.01 1.2)))
    (vox-activity-feed state (vox-activity-test--windows 1200 5))
    (vox-activity-feed state (vox-activity-test--windows 0 59))
    (should-not (vox-activity-feed state (vox-activity-test--windows 1200 1)))
    (should-not (vox-activity-feed state (vox-activity-test--windows 0 59)))
    (should (vox-activity-feed state (vox-activity-test--windows 0 1)))))

(ert-deftest vox-activity-processes-whole-chunk-before-stop ()
  :tags '(vox-unit)
  (let ((state (vox-activity-create 0.01 1.2)))
    (vox-activity-feed state (vox-activity-test--windows 1200 5))
    (should-not
     (vox-activity-feed state (concat (vox-activity-test--windows 0 60)
                                      (vox-activity-test--windows 1200 1))))
    (should (= 0 (vox-activity--silent state)))
    (should (vox-activity-feed state (vox-activity-test--windows 0 60)))))

(ert-deftest vox-activity-partial-voice-defers-stop ()
  :tags '(vox-unit)
  (let ((state (vox-activity-create 0.01 1.2)))
    (vox-activity-feed state (vox-activity-test--windows 1200 5))
    (should-not
     (vox-activity-feed state (concat (vox-activity-test--windows 0 60)
                                      (vox-activity-test--pcm 1200 1))))
    (should-not (vox-activity-feed state (unibyte-string)))
    (should-not (vox-activity-feed state (vox-activity-test--pcm 1200 319)))
    (should (= 0 (vox-activity--silent state)))))

(ert-deftest vox-activity-half-sample-defers-stop ()
  :tags '(vox-unit)
  (let ((state (vox-activity-create 0.01 1.2)))
    (vox-activity-feed state (vox-activity-test--windows 1200 5))
    (should-not
     (vox-activity-feed state (concat (vox-activity-test--windows 0 60)
                                      (unibyte-string 0))))
    (should-not (vox-activity-feed state (unibyte-string)))
    (should (vox-activity-feed state (unibyte-string 0)))))

(ert-deftest vox-activity-signed-little-endian-threshold ()
  :tags '(vox-unit)
  (dolist (sample '(512 -512))
    (let ((state (vox-activity-create (/ 512.0 32768) 0.2)))
      (should-not (vox-activity-feed state (vox-activity-test--windows sample 5)))
      (should (vox-activity--armed state))
      (should (vox-activity-feed state (vox-activity-test--windows 0 10)))))
  (dolist (sample '(511 -511))
    (let ((state (vox-activity-create (/ 512.0 32768) 0.2)))
      (vox-activity-feed state (vox-activity-test--windows sample 5))
      (should-not (vox-activity--armed state))))
  (let ((state (vox-activity-create 1 0.2)))
    (vox-activity-feed state (vox-activity-test--windows 32767 5))
    (should-not (vox-activity--armed state))
    (vox-activity-feed state (vox-activity-test--windows -32768 5))
    (should (vox-activity--armed state))))

(ert-deftest vox-activity-measures-rms-not-peak-or-signed-mean ()
  :tags '(vox-unit)
  (let ((state (vox-activity-create 0.1 0.2)))
    (dotimes (_ 5)
      (vox-activity-feed state (concat (vox-activity-test--pcm 32767 1)
                                      (vox-activity-test--pcm 0 319))))
    (should-not (vox-activity--armed state)))
  (let ((state (vox-activity-create 0.01 0.2)))
    (dotimes (_ 5)
      (vox-activity-feed state (concat (vox-activity-test--pcm 1000 160)
                                      (vox-activity-test--pcm -1000 160))))
    (should (vox-activity--armed state))))

(ert-deftest vox-activity-odd-byte-boundaries-preserve-signed-pcm ()
  :tags '(vox-unit)
  (let* ((state (vox-activity-create 0.01 0.2))
         (bytes (concat (vox-activity-test--windows -1200 5)
                        (vox-activity-test--windows 0 10)))
         result)
    (dotimes (index (length bytes))
      (setq result (vox-activity-feed state (substring bytes index (1+ index))))
      (when (< index (1- (length bytes))) (should-not result)))
    (should result)
    (should-not (vox-activity--pending state))))

(ert-deftest vox-activity-empty-input-is-state-preserving ()
  :tags '(vox-unit)
  (let* ((state (vox-activity-create 0.01 0.2))
         (before (copy-sequence state)))
    (should-not (vox-activity-feed state (unibyte-string)))
    (should (equal before state))
    (should (vox-activity-feed
             state (concat (vox-activity-test--windows 1200 5)
                           (vox-activity-test--windows 0 10))))
    (setq before (copy-sequence state))
    (should (vox-activity-feed state (unibyte-string)))
    (should (equal before state))))

(ert-deftest vox-activity-arbitrary-chunking-has-identical-final-state ()
  :tags '(vox-unit)
  (let* ((bytes (concat (vox-activity-test--windows 0 2)
                        (vox-activity-test--windows -1200 5)
                        (vox-activity-test--windows 0 12)
                        (vox-activity-test--windows 1400 1)
                        (vox-activity-test--windows 0 10)
                        (vox-activity-test--pcm -1000 13)
                        (unibyte-string 7)))
         (whole (vox-activity-create 0.01 0.2))
         (expected (vox-activity-feed whole bytes)))
    (dolist (size '(1 2 3 17 319 320 639 640 641 997 4096))
      (let ((state (vox-activity-create 0.01 0.2)) (position 0) actual)
        (while (< position (length bytes))
          (let ((end (min (+ position size) (length bytes))))
            (setq actual (vox-activity-feed state (substring bytes position end))
                  position end)))
        (should (eq actual expected))
        (should (equal state whole))))))

(ert-deftest vox-activity-configuration-is-validated ()
  :tags '(vox-unit)
  (dolist (threshold '(nil "PRIVATE" nope 0 -0.1 1.01 1.0e+INF 0.0e+NaN))
    (let ((err (should-error (vox-activity-create threshold 1.2) :type 'user-error)))
      (should-not (string-match-p "PRIVATE" (error-message-string err)))))
  (dolist (silence '(nil "PRIVATE" nope 0 0.19 10.01 1.0e+INF 0.0e+NaN))
    (let ((err (should-error (vox-activity-create 0.01 silence) :type 'user-error)))
      (should-not (string-match-p "PRIVATE" (error-message-string err)))))
  (dolist (silence '(0.2 1 1.2 10))
    (should (vox-activity-p (vox-activity-create 1 silence)))))

(ert-deftest vox-activity-fractional-window-silence-rounds-up ()
  :tags '(vox-unit)
  (let ((state (vox-activity-create 0.01 0.201)))
    (vox-activity-feed state (vox-activity-test--windows 1200 5))
    (should-not (vox-activity-feed state (vox-activity-test--windows 0 10)))
    (should (vox-activity-feed state (vox-activity-test--windows 0 1)))))

(ert-deftest vox-activity-rejects-non-unibyte-input-without-retaining-it ()
  :tags '(vox-unit)
  (let* ((state (vox-activity-create 0.01 0.2))
         (before (copy-sequence state)))
    (dolist (input (list nil 42 [1 2] (string #x4e2d)
                        (string-to-multibyte "PRIVATE")))
      (let ((err (should-error (vox-activity-feed state input) :type 'user-error)))
        (should-not (string-match-p "PRIVATE" (error-message-string err))))
      (should (equal before state)))))

(ert-deftest vox-activity-instances-are-independent ()
  :tags '(vox-unit)
  (let* ((one (vox-activity-create 0.01 0.2))
         (two (vox-activity-create 0.01 0.2))
         (before (copy-sequence two)))
    (should-not (eq one two))
    (should (vox-activity-feed
             one (concat (vox-activity-test--windows 1200 5)
                         (vox-activity-test--windows 0 10))))
    (should (equal two before))
    (should-not (vox-activity-feed two (vox-activity-test--windows 0 10)))))

(ert-deftest vox-activity-stop-query-is-read-only-and-not-latched ()
  :tags '(vox-unit)
  (let ((state (vox-activity-create 0.01 0.2)))
    (should-not (vox-activity-stop-p state))
    (vox-activity-feed state (concat (vox-activity-test--windows 1200 5)
                                     (vox-activity-test--windows 0 10)))
    (let ((before (copy-sequence state)))
      (should (vox-activity-stop-p state))
      (should (equal before state)))
    (vox-activity-feed state (vox-activity-test--pcm 1200 1))
    (should-not (vox-activity-stop-p state))
    (vox-activity-feed state (vox-activity-test--pcm 1200 319))
    (should-not (vox-activity-stop-p state))))

(ert-deftest vox-activity-counters-and-storage-remain-bounded ()
  :tags '(vox-unit)
  (let ((state (vox-activity-create 0.01 0.2)))
    (vox-activity-feed state (vox-activity-test--windows 1200 500))
    (should (= 5 (vox-activity--speech state)))
    (vox-activity-feed state (vox-activity-test--windows 0 500))
    (should (= 10 (vox-activity--silent state)))
    (vox-activity-feed state (concat (vox-activity-test--pcm -32768 319)
                                     (unibyte-string 255)))
    (should (= 319 (vox-activity--samples state)))
    (should (<= (vox-activity--energy state) (* 319 32768 32768)))
    (should (= 255 (vox-activity--pending state)))
    (should (< (length state) 16))
    (dotimes (index (length state))
      (let ((slot (aref state index)))
        (should (or (numberp slot) (symbolp slot)))))))

(ert-deftest vox-activity-tiny-positive-threshold-keeps-zero-silent ()
  :tags '(vox-unit)
  (let ((state (vox-activity-create 1.0e-200 0.2)))
    (vox-activity-feed state (vox-activity-test--windows 0 5))
    (should-not (vox-activity--armed state))
    (vox-activity-feed state (vox-activity-test--windows 1 5))
    (should (vox-activity--armed state))
    (should (vox-activity-feed state (vox-activity-test--windows 0 10)))
    (should (vox-activity-feed state (vox-activity-test--pcm 0 1)))
    (should-not (vox-activity-feed state (vox-activity-test--pcm 1 1)))))

(provide 'vox-test-activity)
