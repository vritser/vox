(ert-deftest vox-tts-input-doubao-malformed-packets-are-rejected ()
  :tags '(vox-unit)
  (let ((good (vox-tts-input-test--server 150 "sid" (make-hash-table))))
    (dotimes (size (length good))
      (should-error (vox-tts-doubao--decode (substring good 0 size))))
    (should-error (vox-tts-doubao--decode (concat good "extra")))
    (dolist (change '((0 33) (1 144) (2 17) (3 1) (11 255)))
