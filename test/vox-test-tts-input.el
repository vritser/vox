            (when (= (car (vox-tts-input-test--client bytes)) 1)
              (funcall on-message (vox-tts-input-test--server 50 "connection" (make-hash-table)) 'binary)
              (vox-tts-input-test--control-now context)
              (should (equal (mapcar (lambda (packet) (car (vox-tts-input-test--client packet))) wire)
                             '(1))))))
    (funcall on-open)
    (vox-tts-input-test--control-now context)
    (should (vox-tts--live-p session))
    (should (eq (vox-tts-doubao--context-phase context) 'start))
    (should (timerp (vox-tts-doubao--context-timer context)))
    (vox-tts-input-test--control-now context)
    (should (equal (mapcar (lambda (bytes) (car (vox-tts-input-test--client bytes))) (reverse wire))
                   '(1 100)))))

(provide 'vox-test-tts-input)
