;;; Commentary:
;; Synthetic protocol bytes and harmless local processes; no cloud or speakers.
;;; Code:
(require 'vox-test-support)
(require 'vox)

(defmacro vox-tts-input-test--isolated (&rest body)
  "Evaluate BODY with private speech state and a silent stdin consumer."
  (declare (indent 0) (debug t))
  `(let ((vox-tts--active nil) (vox-tts--generation 0)
         (vox--active-session nil) (vox--starting nil) (vox--reloading nil)
         (vox-tts-player-command '("sh" "-c" "cat >/dev/null"))
         (vox-tts-timeout 5) (vox-tts-playback-timeout 5)
         (vox-tts-max-text-chars 4096) (vox-tts-max-pending-bytes 4096)
         (vox-tts-max-audio-bytes 8192) (vox-tts-max-response-bytes 16384))
     (unwind-protect (progn ,@body) (vox-tts-stop))))

(defun vox-tts-input-test--wait (predicate)
  "Wait briefly for synthetic PREDICATE and require it to become true."
  (let ((deadline (+ (float-time) 3)))
    (while (and (not (funcall predicate)) (< (float-time) deadline))
      (accept-process-output nil 0.01)))
  (should (funcall predicate)))

(ert-deftest vox-tts-input-cli-delivers-text-and-audio-before-input-finishes ()
  :tags '(vox-unit)
  (vox-tts-input-test--isolated
    (let* ((session (vox-speak-open (vox-make-cli "Echo" :tts '(:command ("cat")))))
           (play (symbol-function 'vox-tts--play)) received)
      (cl-letf (((symbol-function 'vox-tts--play)
                 (lambda (owner bytes)
                   (setq received (concat received bytes)) (funcall play owner bytes))))
        (vox-speak-send session "你好\n")
        (vox-tts-input-test--wait (lambda () (equal received (encode-coding-string "你好\n" 'utf-8 t))))
        (should-not (vox-tts--session-source-done session))
        (should (vox-tts--live-p session))
        (vox-speak-send session "world")
        (vox-speak-finish session)
        (vox-tts-input-test--wait (lambda () (not (vox-tts--live-p session))))
        (should (eq (vox-tts--session-state session) 'completed))
        (should (equal received (encode-coding-string "你好\nworld" 'utf-8 t)))))))

(require 'vox-tts-doubao)

(defun vox-tts-input-test--server (event id payload &optional audio)
  "Build a synthetic server EVENT with ID and PAYLOAD, optionally raw AUDIO."
  (let ((bytes (if audio payload (encode-coding-string (vox-json-encode payload) 'utf-8)))
        (id (encode-coding-string id 'utf-8)))
    (cl-labels ((word (n) (apply #'unibyte-string
                                (mapcar (lambda (shift) (logand (ash n shift) 255))
                                        '(-24 -16 -8 0)))))
      (concat (unibyte-string 17 (if audio 180 148) (if audio 0 16) 0)
              (word event) (word (length id)) id (word (length bytes)) bytes))))

(defun vox-tts-input-test--client (bytes)
  "Read synthetic captured client BYTES independently of the production decoder."
  (let ((event (+ (* 256 (aref bytes 6)) (aref bytes 7))))
    (if (memq event '(1 2)) (list event nil (vox-json-read (substring bytes 12)))
      (let* ((size (aref bytes 11)) (id (substring bytes 12 (+ 12 size)))
             (json (decode-coding-string (substring bytes (+ 16 size)) 'utf-8)))
        (list event id (vox-json-read json))))))

(defmacro vox-tts-input-test--doubao (&rest body)
  "Run BODY through real Doubao state transitions over a synthetic transport."
  (declare (indent 0) (debug t))
  `(vox-tts-input-test--isolated
     (let (context on-open on-message on-error on-close headers destination
                   wire during-send (closed 0))
       (cl-letf (((symbol-function 'message) #'ignore)
                 ((symbol-function 'vox-transport-open)
                  (lambda (owner url request-headers opened message failed ended &optional _live _generation)
                    (setq context owner destination url headers request-headers
                          on-open opened on-message message on-error failed on-close ended)
                    'synthetic-socket))
                 ((symbol-function 'vox-transport-send-binary)
                  (lambda (_owner bytes)
                    (push bytes wire)
                    (when during-send (funcall during-send bytes)) t))
                 ((symbol-function 'vox-transport-close)
                  (lambda (_owner) (cl-incf closed))))
         (let ((session (vox-speak-open
                         (vox-make-doubao "Doubao" :asr nil :key "synthetic" :tts t))))
           ,@body)))))

(defun vox-tts-input-test--control-now (context)
  "Drain CONTEXT's scheduled handshake event synchronously."
  (when (timerp (vox-tts-doubao--context-timer context))
    (cancel-timer (vox-tts-doubao--context-timer context)))
  (vox-tts-doubao--control context))

(defun vox-tts-input-test--text-now (session)
  "Drain one scheduled text fragment for SESSION synchronously."
  (when (timerp (vox-tts--session-input-timer session))
    (cancel-timer (vox-tts--session-input-timer session)))
  (vox-tts--input-pump session))

(defmacro vox-tts-input-test--ready ()
  "Drive the current synthetic connection through both acknowledgements."
  '(progn
     (funcall on-open)
     (vox-tts-input-test--control-now context)
     (funcall on-message (vox-tts-input-test--server 50 "connection" (make-hash-table)) 'binary)
     (vox-tts-input-test--control-now context)
     (funcall on-message (vox-tts-input-test--server
                         150 (vox-tts-doubao--context-id context) (make-hash-table)) 'binary)))

(ert-deftest vox-tts-input-doubao-client-wire-matches-static-protocol-layout ()
  :tags '(vox-unit)
  ;; Official static header/event layout; identifiers and payload are synthetic.
  (should (equal (vox-tts-doubao--encode 1 nil (make-hash-table))
                 (concat (unibyte-string 17 20 16 0 0 0 0 1 0 0 0 2) "{}")))
  (should (equal (vox-tts-doubao--encode 101 "sid" (make-hash-table))
                 (concat (unibyte-string 17 20 16 0 0 0 0 101 0 0 0 3)
                         "sid" (unibyte-string 0 0 0 2) "{}")))
  (let ((packet (vox-tts-doubao--decode
                 (concat (unibyte-string 17 180 0 0 0 0 1 96 0 0 0 3)
                         "sid" (unibyte-string 0 0 0 3 0 128 255)))))
    (should (= (plist-get packet :event) 352))
    (should (equal (plist-get packet :id) "sid"))
    (should (equal (plist-get packet :audio) (unibyte-string 0 128 255)))))

(ert-deftest vox-tts-input-doubao-waits-for-readiness-and-finishes-after-text ()
  :tags '(vox-unit)
  (vox-tts-input-test--doubao
    (should (equal destination "wss://openspeech.bytedance.com/api/v3/tts/bidirection"))
    (should (equal (cdr (assoc "X-Api-Key" headers)) "synthetic"))
    (should (equal (cdr (assoc "X-Api-Resource-Id" headers)) "seed-tts-2.0"))
    (should (stringp (cdr (assoc "X-Api-Connect-Id" headers))))
    (vox-speak-send session "你")
    (vox-speak-send session "好。")
    (vox-tts-input-test--text-now session)
    (should-not wire)
    (funcall on-open)
    (vox-tts-input-test--control-now context)
    (should (equal (mapcar (lambda (bytes) (car (vox-tts-input-test--client bytes))) wire) '(1)))
    (funcall on-message (vox-tts-input-test--server 50 "connection" (make-hash-table)) 'binary)
    (vox-tts-input-test--control-now context)
    (should (equal (mapcar (lambda (bytes) (car (vox-tts-input-test--client bytes))) wire) '(100 1)))
    (let ((start (nth 2 (vox-tts-input-test--client (car wire)))))
      (should (= (plist-get start :event) 100))
      (should (equal (plist-get start :namespace) "BidirectionalTTS"))
      (should (equal (plist-get (plist-get start :req_params) :speaker) "zh_female_vv_uranus_bigtts"))
      (should-not (plist-member (plist-get start :req_params) :text)))
    (vox-speak-finish session)
    (vox-tts-input-test--text-now session)
    (should (= (length wire) 2))
    (funcall on-message (vox-tts-input-test--server
                        150 (vox-tts-doubao--context-id context) (make-hash-table)) 'binary)
    (vox-tts-input-test--text-now session)
    (should (equal (plist-get (plist-get (nth 2 (vox-tts-input-test--client (car wire))) :req_params) :text) "你"))
    (should-not (vox-tts--session-input-sent-finish session))
    (vox-tts-input-test--text-now session)
    (let ((events (mapcar #'vox-tts-input-test--client (reverse wire))))
      (should (equal (mapcar #'car events) '(1 100 200 200 102)))
      (should (equal (plist-get (plist-get (nth 2 (nth 3 events)) :req_params) :text) "好。")))
    (should-not (vox-tts--session-source-done session))
    (funcall on-message (vox-tts-input-test--server 352 (vox-tts-doubao--context-id context) "audio" t) 'binary)
    (funcall on-message (vox-tts-input-test--server 152 (vox-tts-doubao--context-id context)
                                                  '((status_code . 20000000))) 'binary)
    (vox-tts-input-test--wait (lambda () (not (vox-tts--live-p session))))
    (should (eq (vox-tts--session-state session) 'completed))
    (should (= closed 1))
    (should (= (car (vox-tts-input-test--client (car wire))) 2))))

(ert-deftest vox-tts-input-doubao-audio-before-text-finish-and-cancel-unsent-text ()
  :tags '(vox-unit)
  (vox-tts-input-test--doubao
    (vox-tts-input-test--ready)
    (vox-speak-send session "first")
    (vox-tts-input-test--text-now session)
    (funcall on-message (vox-tts-input-test--server 352 (vox-tts-doubao--context-id context) "audio" t) 'binary)
    (vox-tts-input-test--wait (lambda () (processp (vox-tts--session-player-process session))))
    (should-not (vox-tts--session-input-closed session))
    (let ((player (vox-tts--session-player-process session)))
      (vox-speak-send session "never sent")
      (vox-speak-stop session)
      (should-not (process-live-p player)))
    (vox-tts-input-test--text-now session)
    (should (equal (mapcar (lambda (bytes) (car (vox-tts-input-test--client bytes))) (reverse wire))
                   '(1 100 200 101)))
    (should (eq (vox-tts--session-state session) 'cancelled))
    (should-not (vox-tts--session-text-queue session))
    (should-not (vox-tts--session-input-timer session))
    (should (= closed 1))
    (should-error (vox-speak-send session "late") :type 'user-error)))

(ert-deftest vox-tts-input-doubao-reentrant-producer-defers-finish-and-nested-send ()
  :tags '(vox-unit)
  (vox-tts-input-test--doubao
    (vox-tts-input-test--ready)
    (let (nested)
      (setq during-send
            (lambda (bytes)
              (when (= (car (vox-tts-input-test--client bytes)) 200)
                (unless nested
                  (setq nested t)
                  (vox-speak-send session "second")
                  (vox-speak-finish session)
                  (vox-tts--input-pump session)
                  (should-not (vox-tts--session-input-sent-finish session))))))
      (vox-speak-send session "first")
      (vox-tts-input-test--text-now session)
      (should (= (length wire) 3))
      (vox-tts-input-test--text-now session)
      (should (equal (mapcar (lambda (bytes) (car (vox-tts-input-test--client bytes))) (reverse wire))
                     '(1 100 200 200 102)))
      (should (= (vox-tts--session-text-count session) 0)))))

